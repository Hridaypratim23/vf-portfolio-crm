<script is:inline define:vars={{ _rcId: client.id, _rcName: client.company_name, _rcStatus: client.status, _isChurn: client.status === 'Churn', _clientId: client.id }}>
// ── Track recent visit in localStorage ─────────────────────────────
(function() {
  try {
    var stored = JSON.parse(localStorage.getItem('vfcrm_recent') || '[]');
    var entry = { id: _rcId, name: _rcName, status: _rcStatus || '' };
    stored = stored.filter(function(c) { return c.id !== entry.id; });
    stored.unshift(entry);
    localStorage.setItem('vfcrm_recent', JSON.stringify(stored.slice(0, 5)));
  } catch(e) {}
})();

// ── Won / Lost churn record save ────────────────────────────────────
if (_isChurn) {
  var _selectedOutcome = null;

  document.querySelectorAll('.churn-outcome-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      _selectedOutcome = btn.dataset.val || null;
      document.querySelectorAll('.churn-outcome-btn').forEach(function(b) {
        var isActive = b.dataset.val === (btn.dataset.val || '');
        b.style.opacity = isActive ? '1' : '0.5';
      });
    });
  });

  var saveBtn = document.getElementById('saveChurnBtn');
  var statusEl = document.getElementById('churnSaveStatus');
  if (saveBtn) saveBtn.addEventListener('click', function() {
    var reason = (document.getElementById('churnReasonInput').value || '').trim();
    saveBtn.disabled = true;
    fetch('/api/client/' + _clientId + '/churn-outcome', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ outcome: _selectedOutcome, reason: reason }),
    })
    .then(function(r) { return r.json(); })
    .then(function(d) {
      saveBtn.disabled = false;
      if (statusEl) {
        statusEl.style.display = 'inline';
        statusEl.textContent = d.ok ? '✓ Saved' : '✗ ' + (d.error || 'Error');
        statusEl.style.color = d.ok ? '#0ba882' : '#c9313e';
        setTimeout(function() { statusEl.style.display = 'none'; }, 3000);
      }
    })
    .catch(function() { saveBtn.disabled = false; });
  });
}
</script>

