---
import {
  getExtraRevenueSumForClient, getExtraRevenueSumForClientFY,
} from '../../lib/db';
import { getClientRevenueSummary, currentFY, fyLabel, contractValueForDisplay, getLiveFxRates, parseDate, isSubscription } from '../../lib/revenue';
import BaseLayout from '../../layouts/BaseLayout.astro';

const db = (Astro.locals as any).runtime.env.DB;
const { id } = Astro.params;
const clientId = parseInt(id || '0');

const ALLOWED_BACKS: Record<string, string> = {
  '/':                    'Dashboard',
  '/clients':             'All Clients',
  '/clients?filter=active': 'Active Clients',
  '/renewals':            'Renewals',
  '/fy-revenue':          'FY Revenue',
};
const rawBack  = Astro.url.searchParams.get('back') || '';
const isFinanceData = rawBack.startsWith('/finance-data');
const backHref  = ALLOWED_BACKS[rawBack] ? rawBack : isFinanceData ? rawBack : '/clients';
const backLabel = ALLOWED_BACKS[rawBack] || (isFinanceData ? 'Finance Data' : 'All Clients');

const [fxRates, batchResults] = await Promise.all([
  getLiveFxRates(),
  db.batch([
    db.prepare('SELECT * FROM clients WHERE id = ?').bind(clientId),
    db.prepare('SELECT * FROM activities WHERE client_id = ? ORDER BY created_at DESC').bind(clientId),
    db.prepare('SELECT * FROM agreements WHERE client_id = ? ORDER BY uploaded_at DESC').bind(clientId),
    db.prepare('SELECT * FROM extra_revenue WHERE client_id = ? ORDER BY financial_year DESC').bind(clientId),
    db.prepare('SELECT * FROM sub_history WHERE client_id = ? ORDER BY financial_year DESC').bind(clientId),
  ]),
]);

const client     = (batchResults[0].results as any[])[0] ?? null;
if (!client) return Astro.redirect('/');
const activities   = batchResults[1].results as any[];
const agreements   = batchResults[2].results as any[];
const extraRevenue = batchResults[3].results as any[];
const subHist      = batchResults[4].results as any[];

const fy = currentFY();
const extraLicAll = getExtraRevenueSumForClient(extraRevenue, clientId, 'lic');
const extraRpAll  = getExtraRevenueSumForClient(extraRevenue, clientId, 'rp');
const extraLicCur = getExtraRevenueSumForClientFY(extraRevenue, clientId, 'lic', fy);
const extraRpCur  = getExtraRevenueSumForClientFY(extraRevenue, clientId, 'rp', fy);

function _toUSD(amount: number, currency: string): number {
  const rate = fxRates[(currency || 'USD').toUpperCase()] ?? 1;
  return amount / rate;
}
const latestCv = contractValueForDisplay(client, subHist, _toUSD);

const revSummary = getClientRevenueSummary(
  client, subHist, extraLicAll, extraRpAll, extraLicCur, extraRpCur, fy
);

// Reward points grouped by their actual currency (so INR ≠ USD)
const rpAllByCur: Record<string, number> = {};
const rpCurByCur: Record<string, number> = {};
for (const r of extraRevenue) {
  if (r.type !== 'Additional Licenses') {
    const cur = (r.currency || 'USD').toUpperCase();
    rpAllByCur[cur] = (rpAllByCur[cur] || 0) + (r.amount || 0);
    if (r.financial_year === fy)
      rpCurByCur[cur] = (rpCurByCur[cur] || 0) + (r.amount || 0);
  }
}
const rpAllEntries  = Object.entries(rpAllByCur).map(([cur, amt]) => ({ cur, amt: Math.round(amt) }));
const rpCurEntries  = Object.entries(rpCurByCur).map(([cur, amt]) => ({ cur, amt: Math.round(amt) }));
// Grand total only makes sense when RP is entirely in the same currency as subscription
const rpSingleCur   = rpAllEntries.length === 1 && rpAllEntries[0].cur === revSummary.currency;
const rpCurSingleCur = rpCurEntries.length === 1 && rpCurEntries[0].cur === revSummary.currency;

const fyYears = Array.from({ length: 6 }, (_, i) => fy - 3 + i);

// Contributor split totals (all converted to USD for comparison)
const cxUSD    = subHist.filter(r => (r.contributor || 'Sales') === 'CX').reduce((s, r) => s + _toUSD(r.amount, r.currency), 0);
const salesUSD = subHist.filter(r => (r.contributor || 'Sales') === 'Sales').reduce((s, r) => s + _toUSD(r.amount, r.currency), 0);
const hasSplit = subHist.length > 0 && (cxUSD > 0 || salesUSD > 0);

function fmtMoney(n: number) { return new Intl.NumberFormat('en-US').format(Math.round(n)); }

const sparkMax = (subHist as any[]).length > 0
  ? Math.max(...(subHist as any[]).map((r: any) => _toUSD(r.amount || 0, r.currency || 'USD')))
  : 0;

// Health score
function clientHealth(): { label: string; cls: string; icon: string } {
  const s = client.status || '';
  if (s === 'Churn') return { label:'Churned',  cls:'health-churned',  icon:'bi-x-circle' };
  if (s.toLowerCase().includes('inactive')) return { label:'Inactive', cls:'health-inactive', icon:'bi-dash-circle' };
  if (!isSubscription(client.type || '')) return { label:'Active', cls:'health-healthy', icon:'bi-check-circle-fill' };
  const end = parseDate(client.agreement_end_date);
  if (!end) return { label:'Active', cls:'health-healthy', icon:'bi-check-circle-fill' };
  const now = new Date();
  const d   = (end.getTime() - now.getTime()) / 86400000;
  if (d < 0)   return { label:'Overdue', cls:'health-overdue',  icon:'bi-exclamation-circle-fill' };
  if (d <= 60) return { label:'At Risk', cls:'health-at-risk',  icon:'bi-exclamation-triangle-fill' };
  return { label:'Healthy', cls:'health-healthy', icon:'bi-check-circle-fill' };
}
const health = clientHealth();

// Inferred client timeline
type TlEvent = { label: string; meta: string; note?: string; dotClass: string; sortKey: number };
const tlEvents: TlEvent[] = [];
if (client.agreement_start_date) {
  const d = parseDate(client.agreement_start_date);
  if (d) tlEvents.push({ label:'Agreement Signed', meta: client.agreement_start_date, dotClass:'dot-green', sortKey: d.getTime() });
}
if (client.campaign_start_date) {
  const d = parseDate(client.campaign_start_date);
  if (d) tlEvents.push({ label:'Campaign Started', meta: client.campaign_start_date, dotClass:'dot-blue', sortKey: d.getTime() });
}
for (const row of (subHist as any[])) {
  const d = new Date(`${row.financial_year}-04-01`);
  tlEvents.push({ label: `${fyLabel(row.financial_year)} Subscription`, meta: `${row.currency} ${fmtMoney(row.amount)}`, dotClass:'dot-blue', sortKey: d.getTime() });
}
for (const r of (extraRevenue as any[])) {
  if ((r.amount || 0) > 0 && r.financial_year) {
    const d = new Date(`${r.financial_year}-04-01`);
    const lbl = r.type === 'Additional Licenses' ? `FY ${String(r.financial_year).slice(-2)}-${String(r.financial_year+1).slice(-2)} Extra Licenses` : `FY ${String(r.financial_year).slice(-2)}-${String(r.financial_year+1).slice(-2)} Reward Points`;
    tlEvents.push({ label: lbl, meta: `${r.currency || 'USD'} ${fmtMoney(r.amount)}`, dotClass:'dot-orange', sortKey: d.getTime() + 1 });
  }
}
if (client.agreement_end_date) {
  const d = parseDate(client.agreement_end_date);
  if (d) {
    const expired = d < new Date();
    tlEvents.push({ label: expired ? 'Agreement Expired' : 'Agreement Expires', meta: client.agreement_end_date, dotClass: expired ? 'dot-red' : 'dot-orange', sortKey: d.getTime() });
  }
}
if ((activities as any[]).length > 0) {
  const last = (activities as any[])[0];
  const ts   = new Date(last.created_at).getTime();
  tlEvents.push({ label: (last.activity_type || 'Activity') + ' Logged', meta: last.created_at?.slice(0,10) || '', note: last.note?.slice(0,60) + (last.note?.length > 60 ? '…' : ''), dotClass:'dot-gray', sortKey: ts });
}
tlEvents.sort((a, b) => b.sortKey - a.sortKey);

const actIconMap: Record<string,string>  = { Note:'bi-sticky', Call:'bi-telephone', Email:'bi-envelope', Meeting:'bi-people', 'Follow-up':'bi-flag' };
const actColorMap: Record<string,string> = { Note:'#8a8aaa', Call:'var(--midnight)', Email:'#0ba882', Meeting:'#c97a30', 'Follow-up':'var(--fit-red)' };
const actBgMap: Record<string,string>    = { Note:'rgba(138,138,170,0.1)', Call:'rgba(41,41,76,0.08)', Email:'rgba(11,168,130,0.1)', Meeting:'rgba(201,122,48,0.1)', 'Follow-up':'rgba(241,81,98,0.1)' };

const activeMonths: string[] = client.active_month
  ? client.active_month.replace(/\//g, ',').split(',').map((m: string) => m.trim()).filter(Boolean)
  : [];

const contactEmails: string[] = client.contact_email
  ? client.contact_email.split(',').map((e: string) => e.trim()).filter(Boolean)
  : [];

const extraTotal = extraRevenue.reduce((s: number, r: any) => s + (r.amount || 0), 0);
---

<BaseLayout title={client.company_name}>

<div class="page-topbar">
    <a href={backHref} class="back-link"><i class="bi bi-arrow-left"></i> <span>{backLabel}</span></a>
    <div style="width:1px;height:24px;background:#eee;"></div>
    <div style="display:flex;align-items:center;gap:10px;">
        <p class="page-title mb-0">{client.company_name}</p>
        <span class={`health-badge ${health.cls}`}><i class={`bi ${health.icon}`}></i>{health.label}</span>
    </div>
    <div class="ms-auto d-flex gap-2">
        <a href={`/edit/${client.id}?back=${encodeURIComponent(backHref)}`} class="btn-vfit" style="font-size:0.75rem;padding:5px 14px;"
           onclick="event.preventDefault();location.replace(this.href)">
            <i class="bi bi-pencil me-1"></i>Edit
        </a>
        <form method="POST" action={`/api/delete/${client.id}`}
              data-async data-success-msg={`${client.company_name} deleted!`}
              onsubmit={`return confirm('Delete ${client.company_name}? This cannot be undone.')`}>
            <button class="btn-vfit-ghost" style="font-size:0.75rem;padding:5px 14px;color:#dc3545;border-color:#dc3545;background:rgba(220,53,69,0.08);">Delete</button>
        </form>
    </div>
</div>

<div class="container" style="padding-top: 1.5rem;">

    <div class="row g-3">

        <!-- Left: Client Details -->
        <div class="col-md-7">
            <div class="card vfit-card mb-3">
                <div class="card-header d-flex align-items-center gap-2">
                    <span style="width:24px;height:24px;border-radius:7px;background:rgba(41,41,76,0.08);display:inline-flex;align-items:center;justify-content:center;">
                        <i class="bi bi-building" style="font-size:0.72rem;color:var(--midnight);"></i>
                    </span>
                    Client Details
                </div>
                <div class="card-body" style="padding:16px 20px;">
                    <div class="row g-3">

                        <div class="col-6">
                            <div class="detail-label">Company ID</div>
                            <div class="detail-value">{client.company_id || '—'}</div>
                        </div>

                        <div class="col-6">
                            <div class="detail-label">Type</div>
                            <div class="detail-value">
                                {(client.type || '').includes('Subscription') ? (
                                    <span class="badge badge-subscription">{client.type}</span>
                                ) : client.type === 'Annual' ? (
                                    <span class="badge badge-annual">{client.type}</span>
                                ) : (
                                    <span class="badge badge-onetime">{client.type}</span>
                                )}
                            </div>
                        </div>

                        <div class="col-6">
                            <div class="detail-label">Status</div>
                            <div class="detail-value">
                                {(() => {
                                    const s = client.status || '';
                                    if (s === 'Active') return <span class="badge badge-active">Active</span>;
                                    if (s.includes('Active')) return <span class="badge badge-repeat">{s}</span>;
                                    if (s.includes('Repeat')) return <span class="badge badge-repeat">{s}</span>;
                                    if (s === 'Churn') return <span class="badge badge-churn">Churn</span>;
                                    return <span class="badge badge-inactive">{s}</span>;
                                })()}
                            </div>
                        </div>

                        <div class="col-6">
                            <div class="detail-label">Employee Base</div>
                            <div class="detail-value">{client.employee_base || '—'}</div>
                        </div>

                        <div class="col-6">
                            <div class="detail-label">Region</div>
                            <div class="detail-value">
                                {client.region
                                    ? <span style="display:inline-flex;align-items:center;gap:5px;background:rgba(11,168,130,0.10);color:#0ba882;border-radius:20px;padding:3px 12px;font-size:0.78rem;font-weight:600;"><i class="bi bi-globe-asia-australia"></i>India &amp; RoW</span>
                                    : '—'}
                            </div>
                        </div>

                        <div class="col-6">
                            <div class="detail-label">CX POC</div>
                            <div class="detail-value">{client.cx_poc || '—'}</div>
                        </div>

                        {latestCv && (
                        <div class="col-12">
                            <div style="background:linear-gradient(135deg,rgba(11,168,130,0.06),rgba(65,216,180,0.04));border:1px solid rgba(11,168,130,0.15);border-radius:10px;padding:10px 14px;display:flex;align-items:center;justify-content:space-between;">
                                <div>
                                    <div class="detail-label" style="margin-bottom:2px;">Contract Value</div>
                                    <div style="font-size:1.1rem;font-weight:700;color:#0ba882;letter-spacing:-0.01em;">
                                        USD {new Intl.NumberFormat('en-US').format(latestCv.usd)}
                                    </div>
                                    <div style="font-size:0.68rem;font-style:italic;color:#9090a8;margin-top:3px;">determined by the last financial agreement</div>
                                </div>
                                {!latestCv.isManual && latestCv.fy !== null ? (
                                <div style="font-size:0.72rem;font-weight:600;color:#0ba882;background:rgba(11,168,130,0.10);padding:4px 10px;border-radius:20px;white-space:nowrap;">
                                    {fyLabel(latestCv.fy)}
                                </div>
                                ) : null}
                            </div>
                        </div>
                        )}

                        <div class="col-12">
                            <button id="viewMoreBtn" onclick="(function(){var el=document.getElementById('clientDetailsMore');var icon=document.getElementById('viewMoreIcon');var lbl=document.getElementById('viewMoreLbl');if(el.style.display==='none'){el.style.display='block';icon.className='bi bi-chevron-up me-1';lbl.textContent='View less';}else{el.style.display='none';icon.className='bi bi-chevron-down me-1';lbl.textContent='View more';}})()" style="background:none;border:none;color:#0ba882;font-size:0.8rem;font-weight:600;cursor:pointer;display:flex;align-items:center;padding:0;gap:2px;">
                                <i class="bi bi-chevron-down me-1" id="viewMoreIcon"></i><span id="viewMoreLbl">View more</span>
                            </button>
                        </div>

                        <div id="clientDetailsMore" class="col-12" style="display:none;">
                            <div class="row g-3">

                                <div class="col-6">
                                    <div class="detail-label">Location (Contracted)</div>
                                    <div class="detail-value">{client.location || '—'}</div>
                                </div>

                                <div class="col-6">
                                    <div class="detail-label">Agreement Start</div>
                                    <div class="detail-value">{client.agreement_start_date || '—'}</div>
                                </div>

                                <div class="col-6">
                                    <div class="detail-label">Agreement End</div>
                                    <div class="detail-value">{client.agreement_end_date || '—'}</div>
                                </div>

                                <div class="col-6">
                                    <div class="detail-label">Campaign Start</div>
                                    <div class="detail-value">{client.campaign_start_date || '—'}</div>
                                </div>

                                <div class="col-6">
                                    <div class="detail-label">Campaign End</div>
                                    <div class="detail-value">{client.campaign_end_date || '—'}</div>
                                </div>

                                <div class="col-6">
                                    <div class="detail-label">Located In</div>
                                    <div class="detail-value">{client.located_in || '—'}</div>
                                </div>

                                {(client.type === 'One Time' || client.type === 'One Time (Repeat)') && (
                                <div class="col-6">
                                    <div class="detail-label">Active Month(s)</div>
                                    <div class="detail-value">
                                        {activeMonths.length > 0 ? activeMonths.map(m => (
                                            <span style="display:inline-block;background:rgba(41,41,76,0.08);color:var(--midnight);border-radius:20px;padding:2px 10px;font-size:0.75rem;font-weight:500;margin-right:4px;">{m}</span>
                                        )) : '—'}
                                    </div>
                                </div>
                                )}

                                <div class="col-6">
                                    <div class="detail-label">Engagement Score</div>
                                    <div class="detail-value">
                                        {client.engagement_score ? (() => {
                                            const eng = parseInt(client.engagement_score) || 0;
                                            if (eng >= 70) return <><span style="font-size:1.2rem;font-weight:700;color:#26a387;">{client.engagement_score}</span><span style="font-size:0.72rem;color:#26a387;margin-left:4px;">High</span></>;
                                            if (eng >= 40) return <><span style="font-size:1.2rem;font-weight:700;color:#c97a30;">{client.engagement_score}</span><span style="font-size:0.72rem;color:#c97a30;margin-left:4px;">Medium</span></>;
                                            return <><span style="font-size:1.2rem;font-weight:700;color:var(--fit-red);">{client.engagement_score}</span><span style="font-size:0.72rem;color:var(--fit-red);margin-left:4px;">Low</span></>;
                                        })() : '—'}
                                    </div>
                                </div>

                            </div>
                        </div>

                    </div>
                </div>
            </div>

            <!-- Contact & Accounts -->
            <div class="card vfit-card mb-3">
                <div class="card-header"><i class="bi bi-person-lines-fill me-2" style="color:var(--fit-green);"></i>Contact &amp; Accounts</div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-6">
                            <div class="detail-label">Contact Name</div>
                            <div class="detail-value">{client.contact_name || '—'}</div>
                        </div>
                        <div class="col-6">
                            <div class="detail-label">POC Email(s)</div>
                            <div class="detail-value">
                                {contactEmails.length > 0 ? contactEmails.map(e => (
                                    <div class="d-flex align-items-center gap-1 mb-1">
                                        <i class="bi bi-envelope" style="font-size:0.7rem; color:#aaa;"></i>
                                        <a href={`mailto:${e}`} style="color:var(--fit-red); font-size:0.85rem;">{e}</a>
                                    </div>
                                )) : '—'}
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="detail-label">Dealspoint Account</div>
                            <div class="detail-value">
                                {client.dealspoint_account ? (
                                <span id="copyDpEmail" data-email={client.dealspoint_account}
                                      title="Click to copy"
                                      style="cursor:pointer;user-select:none;">{client.dealspoint_account}</span>
                                ) : '—'}
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="detail-label">Admin Portal</div>
                            <div class="detail-value">
                                <a href="https://api.vantagecircle.com/" target="_blank" rel="noopener noreferrer"
                                   style="color:var(--fit-red);font-size:0.85rem;display:inline-flex;align-items:center;gap:5px;">
                                    <i class="bi bi-box-arrow-up-right" style="font-size:0.75rem;"></i>
                                    api.vantagecircle.com
                                </a>
                            </div>
                        </div>
                        {client.notes && (
                        <div class="col-12">
                            <div class="detail-label">Notes</div>
                            <div class="detail-value">{client.notes}</div>
                        </div>
                        )}
                    </div>
                </div>
            </div>

            <!-- Revenue Summary -->
            {revSummary.hasAny && (
            <div class="card vfit-card mb-3" style="border-top:3px solid #0ba882;">
                <div class="card-header d-flex align-items-center gap-2">
                    <span style="width:26px;height:26px;border-radius:8px;background:rgba(11,168,130,0.12);display:inline-flex;align-items:center;justify-content:center;">
                        <i class="bi bi-graph-up-arrow" style="color:#0ba882;font-size:0.8rem;"></i>
                    </span>
                    Revenue Summary
                </div>
                <div class="card-body p-0">

                    <!-- All-Time -->
                    <div style="padding:8px 16px 5px; background:#f8f9fb; border-bottom:1px solid #f0f0f5;">
                        <span style="font-size:0.61rem;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;color:#aaa;">All-Time Total</span>
                    </div>
                    <div class="row g-0" style="border-bottom:1px solid #f0f0f5;">
                        <div class="col-6" style="padding:12px 18px; border-right:1px solid #f0f0f5;">
                            <div class="detail-label">Subscription Revenue</div>
                            {revSummary.totalSub > 0 ? (
                            <div style="font-size:1.15rem;font-weight:700;color:var(--midnight);margin-top:3px;">
                                {revSummary.currency} {fmtMoney(revSummary.totalSub)}
                            </div>
                            ) : (
                            <div style="color:#ccc;font-size:0.88rem;margin-top:3px;">—</div>
                            )}
                        </div>
                        <div class="col-6" style="padding:12px 18px;">
                            <div class="detail-label">Reward Points Revenue</div>
                            {rpAllEntries.length > 0 ? (
                            <div style="font-size:1.15rem;font-weight:700;color:#e67e22;margin-top:3px;">
                                {rpAllEntries.map(({ cur, amt }) => (
                                <div>{cur} {fmtMoney(amt)}</div>
                                ))}
                            </div>
                            ) : (
                            <div style="color:#ccc;font-size:0.88rem;margin-top:3px;">—</div>
                            )}
                        </div>
                    </div>
                    {revSummary.totalSub > 0 && rpAllEntries.length > 0 && rpSingleCur && (
                    <div style="padding:7px 18px;border-bottom:1px solid #f0f0f5;display:flex;justify-content:flex-end;align-items:center;gap:8px;">
                        <span style="font-size:0.68rem;color:#aaa;text-transform:uppercase;font-weight:600;">Grand Total</span>
                        <span style="font-size:1rem;font-weight:700;color:var(--midnight);">{revSummary.currency} {fmtMoney(revSummary.totalAll)}</span>
                    </div>
                    )}

                    <!-- Current FY -->
                    <div style="padding:8px 16px 5px; background:#f8f9fb; border-bottom:1px solid #f0f0f5;">
                        <span style="font-size:0.61rem;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;color:#0ba882;">{revSummary.fyLabel} — Current Year</span>
                    </div>
                    <div class="row g-0">
                        <div class="col-6" style="padding:12px 18px; border-right:1px solid #f0f0f5;">
                            <div class="detail-label">Subscription Revenue</div>
                            {revSummary.currentSub > 0 ? (
                            <div style="font-size:1.15rem;font-weight:700;color:#0ba882;margin-top:3px;">
                                {revSummary.currency} {fmtMoney(revSummary.currentSub)}
                            </div>
                            ) : (
                            <div style="color:#ccc;font-size:0.88rem;margin-top:3px;">—</div>
                            )}
                        </div>
                        <div class="col-6" style="padding:12px 18px;">
                            <div class="detail-label">Reward Points Revenue</div>
                            {rpCurEntries.length > 0 ? (
                            <div style="font-size:1.15rem;font-weight:700;color:#e67e22;margin-top:3px;">
                                {rpCurEntries.map(({ cur, amt }) => (
                                <div>{cur} {fmtMoney(amt)}</div>
                                ))}
                            </div>
                            ) : (
                            <div style="color:#ccc;font-size:0.88rem;margin-top:3px;">—</div>
                            )}
                        </div>
                    </div>
                    {revSummary.currentSub > 0 && rpCurEntries.length > 0 && rpCurSingleCur && (
