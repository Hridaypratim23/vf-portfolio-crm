<script is:inline define:vars={{ fyYears, currentFy: fy }}>
// ── Email fields ──────────────────────────────────────────────────────────────
function addEmailField() {
    const container = document.getElementById('email-fields');
    const row = document.createElement('div');
    row.className = 'add-input-wrap email-row';
    row.style.position = 'relative';
    row.innerHTML = `
        <i class="bi bi-envelope add-input-icon" style="position:absolute;left:13px;color:#c8c8d8;font-size:0.82rem;pointer-events:none;"></i>
        <input type="email" name="contact_email" class="add-input" placeholder="email@company.com" style="padding-right:38px;">
        <button type="button" onclick="this.closest('.email-row').remove()"
                style="position:absolute;right:10px;background:none;border:none;color:#ccc;font-size:1.1rem;cursor:pointer;line-height:1;padding:0;transition:color 0.15s;"
                onmouseover="this.style.color='#dc3545'" onmouseout="this.style.color='#ccc'">&times;</button>`;
    container.appendChild(row);
    row.querySelector('input').focus();
}

// ── Sub-history rows ──────────────────────────────────────────────────────────
const FY_OPTIONS  = fyYears.map(yr => ({ value: yr, label: `FY ${yr-2000}-${yr-1999}` }));
const CURRENCIES  = ['USD','INR','EUR','GBP','AED','SGD','CAD','AUD'];

function buildFyOptions(selected) {
    return FY_OPTIONS.map(o =>
        `<option value="${o.value}"${o.value == selected ? ' selected' : ''}>${o.label}</option>`
    ).join('');
}
function buildCurOptions(selected) {
    return CURRENCIES.map(c => `<option${c === (selected || 'USD') ? ' selected' : ''}>${c}</option>`).join('');
}
function updateEmptyMsg() {
    const rows = document.querySelectorAll('.sub-row');
    document.getElementById('sub-history-empty').style.display = rows.length ? 'none' : '';
}
function addSubRow(fy, currency, amount, contributor) {
    const container = document.getElementById('sub-history-rows');
    const id = 'rc_' + Date.now() + Math.random().toString(36).slice(2);
    const row = document.createElement('div');
    row.className = 'sub-row';
    row.innerHTML = `
        <select name="sub_fy" title="Financial Year">${buildFyOptions(fy != null ? fy : currentFy)}</select>
        <select name="sub_currency" class="sub-cur" title="Currency">${buildCurOptions(currency)}</select>
        <input type="number" name="sub_amount" class="sub-amt"
               value="${amount != null ? Math.round(amount) : ''}"
               step="1" min="0" placeholder="Contract amount">
        <select name="sub_contributor" class="sub-contrib-select">
            <option value="Sales"${contributor !== 'CX' ? ' selected' : ''}>Sales</option>
            <option value="CX"${contributor === 'CX' ? ' selected' : ''}>CX</option>
        </select>
        <button type="button" class="sub-remove" title="Remove"
                onclick="this.closest('.sub-row').remove();window.updateEmptyMsg();">
            <i class="bi bi-trash3"></i>
        </button>`;
    container.appendChild(row);
    updateEmptyMsg();
    row.querySelector('.sub-amt').focus();
}
updateEmptyMsg();

// Expose to global scope so inline onclick attributes can reach them
window.addEmailField  = addEmailField;
window.addSubRow      = addSubRow;
window.updateEmptyMsg = updateEmptyMsg;

// ── Agreement upload toggle ───────────────────────────────────────────────────
function enableAgrUpload() {
    document.getElementById('agr-placeholder').style.display = 'none';
    document.getElementById('agr-form').style.display = '';
}
function cancelAgrUpload() {
    document.getElementById('agr-form').style.display = 'none';
    document.getElementById('agr-placeholder').style.display = '';
    document.getElementById('agrFile').value = '';
}
window.enableAgrUpload = enableAgrUpload;
window.cancelAgrUpload = cancelAgrUpload;

// ── Form submit ───────────────────────────────────────────────────────────────
document.getElementById('addForm').addEventListener('submit', async function(e) {
    e.preventDefault();

    const btn    = document.getElementById('submitBtn');
    const banner = document.getElementById('saveBanner');

    btn.disabled  = true;
    btn.innerHTML = '<i class="bi bi-hourglass-split me-2"></i>Saving…';
    banner.style.display    = '';
    banner.style.background = '#f0f4ff';
    banner.style.border     = '1px solid #c0d0ff';
    banner.style.color      = '#1a2a6c';
    banner.innerHTML = '<i class="bi bi-hourglass-split me-2"></i>Adding client to GitHub…';

    try {
        // Step 1: create client (+ sub_history)
        const formData = new FormData(this);
        const res  = await fetch('/api/add', { method: 'POST', body: formData });
        const json = await res.json();
        if (!res.ok || json.error) throw new Error(json.error || 'Save failed');
        const newId = json.id;

        // Step 2: upload agreement if a file was selected
        const agrFile = document.getElementById('agrFile');
        if (agrFile && agrFile.files.length > 0) {
            banner.innerHTML = '<i class="bi bi-hourglass-split me-2"></i>Uploading agreement…';
            const agrForm = new FormData();
            agrForm.append('file', agrFile.files[0]);
            agrForm.append('doc_type', document.getElementById('agrDocType').value);
            const agrRes  = await fetch(`/api/client/${newId}/upload-agreement`, { method: 'POST', body: agrForm });
            const agrJson = await agrRes.json();
            if (!agrRes.ok || agrJson.error) throw new Error('Agreement upload failed: ' + agrJson.error);
        }

        banner.style.background = '#eafaf3';
        banner.style.border     = '1px solid #6fcfa0';
        banner.style.color      = '#1a6c3a';
        banner.innerHTML = `<i class="bi bi-check-circle-fill me-2"></i><strong>Client added!</strong> The live site is rebuilding — it will appear in ~60 seconds. <a href="/clients" style="color:inherit;text-decoration:underline;font-weight:600;">Go to Clients →</a>`;
        btn.innerHTML = '<i class="bi bi-check2 me-2"></i>Saved!';
        this.reset();
        cancelAgrUpload();
        document.querySelectorAll('.sub-row').forEach(r => r.remove());
        updateEmptyMsg();
    } catch (err) {
        banner.style.background = '#fff0f0';
        banner.style.border     = '1px solid #f0a0a0';
        banner.style.color      = '#8b0000';
        banner.innerHTML = '<i class="bi bi-exclamation-triangle-fill me-2"></i><strong>Error:</strong> ' + err.message;
        btn.disabled  = false;
        btn.innerHTML = '<i class="bi bi-check2-circle me-2"></i>Save Client';
    }
});
</script>

