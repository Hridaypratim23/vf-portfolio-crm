<script is:inline>
// Parse legacy date formats like "01-Aug-25", "31-July-26", "1/10/2025"
function parseLegacyDate(s) {
    if (!s) return null;
    s = s.trim();
    // DD/MM/YYYY or D/M/YYYY
    if (/^\d{1,2}\/\d{1,2}\/\d{4}$/.test(s)) {
        var p = s.split('/');
        return new Date(+p[2], +p[1]-1, +p[0]);
    }
    // MM/DD/YYYY style – if first part >12 it's DD
    if (/^\d{1,2}\/\d{1,2}\/\d{4}$/.test(s)) {
        var p = s.split('/');
        return +p[0]>12 ? new Date(+p[2],+p[1]-1,+p[0]) : new Date(+p[2],+p[0]-1,+p[1]);
    }
    // DD-Mon-YY or DD-Month-YY or DD-Mon-YYYY
    if (/^\d{1,2}-[A-Za-z]+-\d{2,4}$/.test(s)) {
        var months = {jan:0,feb:1,mar:2,apr:3,may:4,jun:5,jul:6,aug:7,sep:8,oct:9,nov:10,dec:11,
                      january:0,february:1,march:2,april:3,june:5,july:6,august:7,september:8,october:9,november:10,december:11};
        var p = s.split('-');
        var yr = +p[2]; if (yr < 100) yr += 2000;
        var mo = months[p[1].toLowerCase().slice(0,3)];
        if (mo !== undefined) return new Date(yr, mo, +p[0]);
    }
    // ISO YYYY-MM-DD
    if (/^\d{4}-\d{2}-\d{2}$/.test(s)) {
        var p = s.split('-'); return new Date(+p[0],+p[1]-1,+p[2]);
    }
    var d = new Date(s);
    return isNaN(d.getTime()) ? null : d;
}

document.querySelectorAll('.date-pick').forEach(function(el) {
    var raw = el.dataset.date || '';
    var parsed = parseLegacyDate(raw);
    flatpickr(el, {
        dateFormat: 'd/m/Y',
        defaultDate: parsed || undefined,
        allowInput: true,
        disableMobile: false,
        animate: true,
    });
});

(function() {
    var typeSelect = document.querySelector('select[name="type"]');
    var activeMonthField = document.getElementById('active-month-field');
    function toggleActiveMonth() {
        var v = typeSelect ? typeSelect.value : '';
        if (activeMonthField) {
            activeMonthField.style.display = (v === 'One Time' || v === 'One Time (Repeat)') ? '' : 'none';
        }
    }
    if (typeSelect) typeSelect.addEventListener('change', toggleActiveMonth);
    toggleActiveMonth();
})();
</script>

