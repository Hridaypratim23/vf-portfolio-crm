---
import { getClientById, getSubHistory } from '../../lib/db';
import { currentFY } from '../../lib/revenue';
import BaseLayout from '../../layouts/BaseLayout.astro';

const db = (Astro.locals as any).runtime.env.DB;
const { id } = Astro.params;
const clientId = parseInt(id || '0');

const client = await getClientById(db, clientId);
if (!client) return Astro.redirect('/');

const subHistory = await getSubHistory(db, clientId);
const fy = currentFY();
const fyYears = Array.from({ length: 8 }, (_, i) => fy - 5 + i);
const subHistoryJson = JSON.stringify(subHistory);

const legacyTypeMap: Record<string,string> = {
  'Subscription': 'Annual',
  'Subscription (Partnership)': 'Annual (Partnership)',
  'One time': 'One Time',
  'One time (Repeat)': 'One Time (Repeat)',
};
const mappedType = legacyTypeMap[(client as any).type || ''] ?? ((client as any).type || '');

const rawBack = Astro.url.searchParams.get('back') || '';
const safeBack = (rawBack.startsWith('/') && !rawBack.startsWith('//')) ? rawBack : '';
const backQuery = safeBack ? `?back=${encodeURIComponent(safeBack)}` : '';
---

<BaseLayout title={`Edit ${client.company_name}`}>

<div class="page-topbar">
    <a href={`/client/${client.id}${backQuery}`} class="back-link"><i class="bi bi-arrow-left"></i> {client.company_name}</a>
    <div style="width:1px;height:24px;background:#eee;"></div>
    <p class="page-title mb-0">Edit Client</p>
</div>

<!-- Hero Banner -->
<div class="add-client-hero" style="background:linear-gradient(135deg,#0f2027 0%,#1a2a3a 55%,#162235 100%);">
    <div class="add-hero-glow add-hero-glow-1" style="background:rgba(65,216,180,0.18);"></div>
    <div class="add-hero-glow add-hero-glow-2" style="background:rgba(41,41,76,0.25);left:auto;right:5%;"></div>
    <div class="add-hero-glow add-hero-glow-3" style="background:rgba(255,157,87,0.10);"></div>
    <div class="add-hero-content">
        <div class="add-hero-icon" style="background:linear-gradient(135deg,rgba(65,216,180,0.22),rgba(11,168,130,0.12));border-color:rgba(65,216,180,0.3);color:#41D8B4;">
            <i class="bi bi-pencil-square"></i>
        </div>
        <div>
            <div class="add-hero-title">{client.company_name}</div>
            <div class="add-hero-sub">Edit client details below.</div>
        </div>
    </div>
</div>

<div class="add-form-wrap">

    <div id="saveBanner" class="add-save-banner" style="display:none;"></div>

    <form id="editForm" method="POST" action={`/api/edit/${client.id}`} data-back={backQuery}>

        <!-- ── Section 1: Identity ─────────────────────────── -->
        <div class="add-section">
            <div class="add-section-head">
                <span class="add-section-num">01</span>
                <span class="add-section-icon" style="background:rgba(65,216,180,0.12);color:#0ba882;"><i class="bi bi-building"></i></span>
                <div>
                    <div class="add-section-title">Company Identity</div>
                    <div class="add-section-sub">Core identification details</div>
                </div>
            </div>
            <div class="add-section-body">
                <div class="row g-3">
                    <div class="col-md-4">
                        <div class="add-field">
                            <label class="add-label">Company ID</label>
                            <div class="add-input-wrap">
                                <i class="bi bi-hash add-input-icon"></i>
                                <input type="text" name="company_id" class="add-input" value={client.company_id || ''} placeholder="e.g. 1767">
                            </div>
                        </div>
                    </div>
                    <div class="col-md-8">
                        <div class="add-field">
                            <label class="add-label">Company Name <span class="add-required">*</span></label>
                            <div class="add-input-wrap">
                                <i class="bi bi-briefcase add-input-icon"></i>
                                <input type="text" name="company_name" class="add-input" value={client.company_name} required>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="add-field">
                            <label class="add-label">Type</label>
                            <div class="add-input-wrap">
                                <i class="bi bi-diagram-3 add-input-icon"></i>
                                <select name="type" class="add-input add-select">
                                    {['Annual','Annual (Partnership)','One Time','One Time (Repeat)','One Time (Partnership)'].map(opt => (
                                        <option selected={mappedType === opt}>{opt}</option>
                                    ))}
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="add-field">
                            <label class="add-label">Status</label>
                            <div class="add-input-wrap">
                                <i class="bi bi-activity add-input-icon"></i>
                                <select name="status" class="add-input add-select">
                                    {['Active','Inactive','Active (Repeat client)','Inactive (Repeat)','Churn'].map(opt => (
                                    <option selected={client.status === opt}>{opt}</option>
                                    ))}
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="add-field">
                            <label class="add-label">Employee Base</label>
                            <div class="add-input-wrap">
                                <i class="bi bi-people add-input-icon"></i>
                                <input type="text" name="employee_base" class="add-input" value={client.employee_base || ''} placeholder="e.g. 500">
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="add-field">
                            <label class="add-label">Location (Originally Contracted)</label>
                            <div class="add-input-wrap">
                                <i class="bi bi-geo-alt add-input-icon"></i>
                                <input type="text" name="location" class="add-input" value={client.location || ''} placeholder="e.g. India">
                            </div>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="add-field">
                            <label class="add-label">Located In <span class="add-label-hint">(Participant countries)</span></label>
                            <div class="add-input-wrap">
                                <i class="bi bi-globe-asia-australia add-input-icon"></i>
                                <input type="text" name="located_in" class="add-input" value={client.located_in || ''} placeholder="e.g. India, UK, US">
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="add-field">
                            <label class="add-label">Region <span class="add-required">*</span></label>
                            <div class="region-radio-group">
                                <label class="region-radio-opt">
                                    <input type="radio" name="region" value="India & RoW" checked>
                                    <span class="region-radio-pill">
                                        <i class="bi bi-globe-asia-australia me-1"></i>India &amp; RoW
                                    </span>
                                </label>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="add-field">
                            <label class="add-label">CX POC</label>
                            <div class="add-input-wrap">
                                <i class="bi bi-headset add-input-icon"></i>
                                <input type="text" name="cx_poc" class="add-input" value={client.cx_poc || ''} placeholder="e.g. Riya Sharma">
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ── Section 2: Timeline ─────────────────────────── -->
        <div class="add-section">
            <div class="add-section-head">
                <span class="add-section-num">02</span>
                <span class="add-section-icon" style="background:rgba(255,157,87,0.12);color:#c97a30;"><i class="bi bi-calendar3"></i></span>
                <div>
                    <div class="add-section-title">Agreement &amp; Campaign</div>
                    <div class="add-section-sub">Contract dates and campaign window</div>
                </div>
            </div>
            <div class="add-section-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="add-field">
                            <label class="add-label">Agreement Start Date <span class="add-label-hint">(DD/MM/YYYY)</span></label>
                            <div class="add-input-wrap">
                                <i class="bi bi-calendar-check add-input-icon"></i>
                                <input type="text" name="agreement_start_date" class="add-input date-pick" autocomplete="off"
                                       data-date={client.agreement_start_date || ''} placeholder="DD/MM/YYYY">
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="add-field">
                            <label class="add-label">Agreement End Date <span class="add-label-hint">(DD/MM/YYYY)</span></label>
                            <div class="add-input-wrap">
                                <i class="bi bi-calendar-x add-input-icon"></i>
                                <input type="text" name="agreement_end_date" class="add-input date-pick" autocomplete="off"
                                       data-date={client.agreement_end_date || ''} placeholder="DD/MM/YYYY">
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="add-field">
                            <label class="add-label">Campaign Start Date <span class="add-label-hint">(DD/MM/YYYY)</span></label>
                            <div class="add-input-wrap">
                                <i class="bi bi-lightning add-input-icon"></i>
                                <input type="text" name="campaign_start_date" class="add-input date-pick" autocomplete="off"
                                       data-date={client.campaign_start_date || ''} placeholder="DD/MM/YYYY">
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="add-field">
                            <label class="add-label">Campaign End Date <span class="add-label-hint">(DD/MM/YYYY)</span></label>
                            <div class="add-input-wrap">
                                <i class="bi bi-lightning-charge add-input-icon"></i>
                                <input type="text" name="campaign_end_date" class="add-input date-pick" autocomplete="off"
                                       data-date={client.campaign_end_date || ''} placeholder="DD/MM/YYYY">
                            </div>
                        </div>
                    </div>
                    <div class="col-md-8" id="active-month-field">
                        <div class="add-field">
                            <label class="add-label">Active Month(s) <span class="add-label-hint">(One-time clients)</span></label>
                            <div class="add-input-wrap">
                                <i class="bi bi-calendar-month add-input-icon"></i>
                                <input type="text" name="active_month" class="add-input"
                                       value={client.active_month || ''} placeholder="e.g. March  or  July/October">
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="add-field">
                            <label class="add-label">Engagement Score <span class="add-label-hint">(0–100)</span></label>
                            <div class="add-input-wrap">
                                <i class="bi bi-stars add-input-icon"></i>
                                <input type="text" name="engagement_score" class="add-input"
                                       value={client.engagement_score || ''} placeholder="e.g. 72">
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ── Section 3: Contact ──────────────────────────── -->
        <div class="add-section">
            <div class="add-section-head">
                <span class="add-section-num">03</span>
                <span class="add-section-icon" style="background:rgba(241,81,98,0.10);color:var(--fit-red);"><i class="bi bi-person-lines-fill"></i></span>
                <div>
                    <div class="add-section-title">Contact Details</div>
                    <div class="add-section-sub">POC and account information</div>
                </div>
            </div>
            <div class="add-section-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="add-field">
                            <label class="add-label">Contact Name</label>
                            <div class="add-input-wrap">
                                <i class="bi bi-person add-input-icon"></i>
                                <input type="text" name="contact_name" class="add-input" value={client.contact_name || ''} placeholder="e.g. Priya Sharma">
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="add-field">
                            <label class="add-label">Dealspoint Account</label>
                            <div class="add-input-wrap">
                                <i class="bi bi-link-45deg add-input-icon"></i>
                                <input type="text" name="dealspoint_account" class="add-input" value={client.dealspoint_account || ''} placeholder="dealspoint@company.com">
                            </div>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="add-field">
                            <label class="add-label">POC Email(s)</label>
                            <div id="email-fields" class="d-flex flex-column gap-2"></div>
                            <div id="email-init" data-emails={client.contact_email || ''} style="display:none;"></div>
                            <button type="button" onclick="window.addEmailField('')" class="add-email-more mt-1">
                                <i class="bi bi-plus-circle me-1"></i>Add another email
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ── Section 4: Subscription Revenue ───────────────── -->
        <div class="add-section">
            <div class="add-section-head">
                <span class="add-section-num">04</span>
                <span class="add-section-icon" style="background:rgba(65,216,180,0.12);color:#0ba882;"><i class="bi bi-graph-up-arrow"></i></span>
                <div>
                    <div class="add-section-title">Subscription Revenue</div>
                    <div class="add-section-sub">Contract value per financial year</div>
                </div>
            </div>
            <div class="add-section-body">
                <div id="sub-history-rows" class="d-flex flex-column gap-2 mb-2"></div>
                <div id="sub-history-empty" style="font-size:0.78rem;color:#bbb;padding:4px 0;display:none;">
                    No entries yet — click below to add a financial year.
                </div>
                <button type="button" onclick="window.addSubRow(null,null,null,null)" class="add-email-more mt-1">
                    <i class="bi bi-plus-circle me-1"></i>Add Financial Year
                </button>
            </div>
        </div>

        <!-- ── Section 5: Contract Value Override ───────────── -->
        <div class="add-section">
            <div class="add-section-head">
                <span class="add-section-num">05</span>
                <span class="add-section-icon" style="background:rgba(11,168,130,0.12);color:#0ba882;"><i class="bi bi-currency-dollar"></i></span>
                <div>
                    <div class="add-section-title">Contract Value Override</div>
                    <div class="add-section-sub">Manually set a display contract value — takes priority over FY breakdown</div>
                </div>
            </div>
            <div class="add-section-body">
                <div class="row g-3">
                    <div class="col-8">
                        <label class="add-label">Contract Value</label>
                        <div class="add-input-wrap">
                            <i class="bi bi-cash-stack add-input-icon"></i>
                            <input type="number" name="manual_contract_value"
                                   class="add-input"
                                   value={client.manual_contract_value || ''}
                                   placeholder="Leave blank to use FY breakdown"
                                   min="0" step="1" />
                        </div>
                    </div>
                    <div class="col-4">
                        <label class="add-label">Currency</label>
                        <div class="add-input-wrap">
                            <i class="bi bi-globe add-input-icon"></i>
                            <select name="manual_contract_currency" class="add-input">
                                {['USD','INR','EUR','GBP','AED','SGD','CAD','AUD'].map(cur => (
                                    <option value={cur} selected={(client.manual_contract_currency || 'USD') === cur}>{cur}</option>
                                ))}
                            </select>
                        </div>
                    </div>
                </div>
                <p style="font-size:0.74rem;color:#aaa;margin-top:8px;margin-bottom:0;">
                    <i class="bi bi-info-circle me-1"></i>
                    Use this for clients whose contract is spread across two financial years and are invoiced separately.
                </p>
            </div>
        </div>

        <!-- ── Section 6: Notes ────────────────────────────── -->
        <div class="add-section">
            <div class="add-section-head">
                <span class="add-section-num">06</span>
                <span class="add-section-icon" style="background:rgba(41,41,76,0.08);color:var(--midnight);"><i class="bi bi-journal-text"></i></span>
                <div>
                    <div class="add-section-title">Notes</div>
                    <div class="add-section-sub">Any additional context or remarks</div>
                </div>
            </div>
            <div class="add-section-body">
                <div class="add-field">
                    <div class="add-input-wrap" style="align-items:flex-start;">
                        <i class="bi bi-pencil-square add-input-icon" style="margin-top:12px;"></i>
                        <textarea name="notes" class="add-input" rows="4" style="resize:vertical;">{client.notes || ''}</textarea>
                    </div>
                </div>
            </div>
        </div>

        <!-- ── Submit bar ──────────────────────────────────── -->
        <div class="add-submit-bar">
            <a href={`/client/${client.id}${backQuery}`} class="add-cancel-btn">
                <i class="bi bi-x me-1"></i>Cancel
            </a>
            <button type="submit" id="submitBtn" class="add-submit-btn" style="background:linear-gradient(135deg,#0ba882,#41D8B4);box-shadow:0 6px 20px rgba(65,216,180,0.30);">
                <i class="bi bi-check2-circle me-2"></i>Save Changes
            </button>
        </div>

    </form>
</div>

<style>
/* ── shared with add page ── */
.add-client-hero {
    position: relative;
    padding: 36px 40px;
    overflow: hidden;
}
.add-hero-glow {
    position: absolute; border-radius: 50%;
    pointer-events: none; filter: blur(60px);
}
.add-hero-glow-1 { width:280px;height:280px;top:-80px;right:10%; }
.add-hero-glow-2 { width:200px;height:200px;bottom:-60px;left:5%; }
.add-hero-glow-3 { width:160px;height:160px;top:20px;left:40%; }
.add-hero-content {
    position: relative; z-index: 1;
    display: flex; align-items: center; gap: 18px;
}
.add-hero-icon {
    width:56px;height:56px;border:1.5px solid;border-radius:16px;
    display:flex;align-items:center;justify-content:center;
    font-size:1.5rem;flex-shrink:0;backdrop-filter:blur(8px);
}
.add-hero-title { font-size:1.5rem;font-weight:700;color:white;letter-spacing:-0.02em;line-height:1.1; }
.add-hero-sub   { font-size:0.82rem;color:rgba(255,255,255,0.45);margin-top:4px; }

.add-form-wrap  { max-width:780px;margin:0 auto;padding:32px 28px 48px; }
.add-save-banner{ border-radius:12px;padding:13px 18px;font-size:0.85rem;margin-bottom:24px; }

.add-section {
    background:white;border-radius:18px;
    box-shadow:0 4px 20px rgba(29,34,40,0.07);
    margin-bottom:20px;overflow:hidden;
    border:1px solid rgba(41,41,76,0.06);
    transition:box-shadow 0.2s;
}
.add-section:hover { box-shadow:0 8px 32px rgba(29,34,40,0.11); }

.add-section-head {
    display:flex;align-items:center;gap:14px;
    padding:16px 22px;
    background:linear-gradient(to right,rgba(41,41,76,0.03),transparent);
    border-bottom:1px solid rgba(41,41,76,0.06);
}
.add-section-num  { font-size:0.62rem;font-weight:800;color:#ccc;letter-spacing:0.08em;min-width:22px; }
.add-section-icon { width:36px;height:36px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:0.95rem;flex-shrink:0; }
.add-section-title{ font-size:0.88rem;font-weight:700;color:var(--midnight);line-height:1.2; }
.add-section-sub  { font-size:0.71rem;color:#bbb;margin-top:1px; }
.add-section-body { padding:22px; }

.add-label      { font-size:0.68rem;font-weight:700;color:#8a8aaa;text-transform:uppercase;letter-spacing:0.06em;display:block;margin-bottom:7px; }
.add-label-hint { font-weight:400;text-transform:none;color:#bbb;font-size:0.67rem;letter-spacing:0; }
.add-required   { color:var(--fit-red);font-size:0.75rem; }

.add-input-wrap { position:relative;display:flex;align-items:center; }
.add-input-icon {
    position:absolute;left:13px;color:#c8c8d8;font-size:0.82rem;
    pointer-events:none;transition:color 0.2s;z-index:1;
}
.add-input {
    width:100%;padding:10px 14px 10px 36px;
    border:1.5px solid #e8e8f0;border-radius:12px;
    font-size:0.84rem;font-family:'Poppins',sans-serif;
    color:var(--midnight);background:#fafafa;outline:none;
    transition:border-color 0.2s,box-shadow 0.2s,background 0.2s;
    -webkit-appearance:none;
}
.add-input::placeholder { color:#c4c4d4;font-size:0.8rem; }
.add-input:focus {
    border-color:transparent;background:white;
    box-shadow:0 0 0 2px rgba(65,216,180,0.2),0 2px 12px rgba(65,216,180,0.08);
    background:linear-gradient(white,white) padding-box,
               linear-gradient(135deg,#41D8B4 0%,#0ba882 100%) border-box;
}
.add-input:focus ~ .add-input-icon,
.add-input-wrap:focus-within .add-input-icon { color:#0ba882; }
.add-select { cursor:pointer; }
textarea.add-input { resize:vertical;padding-top:10px; }


/* ── Region radio group ── */
.region-radio-group { display:flex; gap:10px; }
.region-radio-opt { display:flex; cursor:pointer; }
.region-radio-opt input[type=radio] { position:absolute; opacity:0; width:0; height:0; }
.region-radio-pill {
    display:inline-flex; align-items:center;
    padding:8px 18px;
    border:1.5px solid #e8e8f0;
    border-radius:20px;
    font-size:0.78rem; font-weight:600; color:#8a8aaa;
    background:#fafafa;
    transition:all 0.18s; white-space:nowrap; user-select:none;
}
.region-radio-opt input[type=radio]:checked + .region-radio-pill {
    border-color:transparent; color:white;
    background:linear-gradient(135deg,#41D8B4 0%,#0ba882 100%);
    box-shadow:0 2px 10px rgba(65,216,180,0.3);
}
.region-radio-opt:hover .region-radio-pill { border-color:#c0e8df; color:var(--midnight); }

/* email more / add-fy button */
.add-email-more {
    margin-top:8px;background:none;border:none;padding:0;
    font-size:0.75rem;color:var(--fit-red);cursor:pointer;
    font-family:'Poppins',sans-serif;font-weight:500;
    display:flex;align-items:center;gap:4px;
    opacity:0.85;transition:opacity 0.15s;
}
.add-email-more:hover { opacity:1; }

/* submit bar */
.add-submit-bar { display:flex;align-items:center;justify-content:flex-end;gap:12px;padding-top:6px; }
.add-cancel-btn {
    display:inline-flex;align-items:center;gap:5px;
    padding:10px 22px;border-radius:12px;
    background:rgba(41,41,76,0.06);color:#888 !important;
    text-decoration:none;font-size:0.83rem;font-weight:500;
    border:1.5px solid transparent;transition:all 0.15s;
}
.add-cancel-btn:hover { background:rgba(41,41,76,0.10);color:var(--midnight)!important; }
.add-submit-btn {
    display:inline-flex;align-items:center;gap:6px;
    padding:11px 32px;border-radius:12px;color:white;
    font-size:0.88rem;font-weight:600;border:none;cursor:pointer;
    transition:opacity 0.15s,transform 0.15s,box-shadow 0.15s;
    font-family:'Poppins',sans-serif;
}
.add-submit-btn:hover { opacity:0.92;transform:translateY(-2px); }
.add-submit-btn:disabled { opacity:0.65;transform:none;cursor:not-allowed; }
</style>

<script is:inline define:vars={{ subHistoryJson, currentFy: fy, fyYears, clientCurrency: client.currency || 'USD', clientContractValue: client.contract_value || 0, clientContractFyOverride: client.contract_fy_override || null }}>

// ── Email fields ──────────────────────────────────────────────
function addEmailField(val) {
    const container = document.getElementById('email-fields');
    const row = document.createElement('div');
    row.className = 'add-input-wrap email-row';
    row.style.position = 'relative';
    row.innerHTML = `
        <i class="bi bi-envelope add-input-icon" style="position:absolute;left:13px;color:#c8c8d8;font-size:0.82rem;pointer-events:none;z-index:1;"></i>
        <input type="email" name="contact_email" class="add-input"
               value="${(val || '').replace(/"/g,'&quot;')}"
               placeholder="email@company.com" style="padding-right:38px;">
        <button type="button" onclick="this.closest('.email-row').remove()"
                style="position:absolute;right:10px;background:none;border:none;color:#ccc;font-size:1.1rem;cursor:pointer;line-height:1;padding:0;transition:color 0.15s;z-index:1;"
                onmouseover="this.style.color='#dc3545'" onmouseout="this.style.color='#ccc'">&times;</button>`;
    container.appendChild(row);
}
const raw = document.getElementById('email-init').dataset.emails || '';
const emails = raw ? raw.split(',').map(e => e.trim()).filter(Boolean) : [''];
emails.forEach(e => addEmailField(e));
window.addEmailField = addEmailField;

// ── Sub-history rows ──────────────────────────────────────────
const FY_OPTIONS  = fyYears.map(yr => ({ value: yr, label: `FY ${yr-2000}-${yr-1999}` }));
const CURRENCIES  = ['USD','INR','EUR','GBP','AED','SGD','CAD','AUD'];

function buildFyOptions(selected) {
    return FY_OPTIONS.map(o =>
        `<option value="${o.value}"${o.value == selected ? ' selected' : ''}>${o.label}</option>`
    ).join('');
}
function buildCurOptions(sel) {
    const def = sel || clientCurrency || 'USD';
    return CURRENCIES.map(c => `<option${c === def ? ' selected' : ''}>${c}</option>`).join('');
}
function updateEmptyMsg() {
    const rows = document.querySelectorAll('.sub-row');
    document.getElementById('sub-history-empty').style.display = rows.length ? 'none' : '';
}
function addSubRow(fy, currency, amount, contributor) {
    const container = document.getElementById('sub-history-rows');
    const id = 'rc_' + Date.now() + Math.random().toString(36).slice(2);
    const row = document.createElement('div');
    row.className = 'sub-row';
    row.innerHTML = `
        <select name="sub_fy" title="Financial Year">${buildFyOptions(fy != null ? fy : currentFy)}</select>
        <select name="sub_currency" class="sub-cur" title="Currency">${buildCurOptions(currency)}</select>
        <input type="number" name="sub_amount" class="sub-amt"
               value="${amount != null ? Math.round(amount) : ''}"
               step="1" min="0" placeholder="Contract amount">
        <select name="sub_contributor" class="sub-contrib-select">
            <option value="Sales"${contributor !== 'CX' ? ' selected' : ''}>Sales</option>
            <option value="CX"${contributor === 'CX' ? ' selected' : ''}>CX</option>
        </select>
        <button type="button" class="sub-remove" title="Remove"
                onclick="this.closest('.sub-row').remove();window.updateEmptyMsg();">
            <i class="bi bi-trash3"></i>
        </button>`;
    container.appendChild(row);
    updateEmptyMsg();
}
window.addSubRow      = addSubRow;
window.updateEmptyMsg = updateEmptyMsg;

const subHistory = JSON.parse(subHistoryJson);
if (subHistory.length > 0) {
    subHistory.forEach(e => addSubRow(e.financial_year, e.currency, e.amount, e.contributor || null));
} else {
    const cv  = clientContractValue;
    const cur = clientCurrency;
    const overrideFy = clientContractFyOverride || currentFy;
    if (cv > 0) addSubRow(overrideFy, cur, cv);
}
updateEmptyMsg();

// ── Async submit ──────────────────────────────────────────────
document.getElementById('editForm').addEventListener('submit', async function(e) {
    e.preventDefault();

    const btn    = document.getElementById('submitBtn');
    const banner = document.getElementById('saveBanner');

    btn.disabled  = true;
    btn.innerHTML = '<i class="bi bi-hourglass-split me-2"></i>Saving…';
    banner.style.cssText = 'display:block;background:#f0f4ff;border:1px solid #c0d0ff;color:#1a2a6c;border-radius:12px;padding:13px 18px;font-size:0.85rem;margin-bottom:24px;';
    banner.innerHTML = '<i class="bi bi-hourglass-split me-2"></i>Saving changes to GitHub…';

    try {
        const formData = new FormData(this);
        const res  = await fetch(this.action, { method: 'POST', body: formData });
        const json = await res.json();
        if (!res.ok || json.error) throw new Error(json.error || 'Save failed');

        const clientId = this.action.split('/').pop();
        const backQ = this.dataset.back || '';
        banner.style.cssText = 'display:block;background:#eafaf3;border:1px solid #6fcfa0;color:#1a6c3a;border-radius:12px;padding:13px 18px;font-size:0.85rem;margin-bottom:24px;';
        const contribLine = json.saved_contributors?.length ? `<br><span style="font-size:0.78rem;opacity:0.8;">Saved contributors → ${json.saved_contributors.join(' · ')}</span>` : '';
        banner.innerHTML = `<i class="bi bi-check-circle-fill me-2"></i><strong>Saved!</strong> Changes are live instantly.${contribLine} <a href="/client/${clientId}${backQ}" onclick="event.preventDefault();location.replace(this.href)" style="color:inherit;text-decoration:underline;font-weight:600;">Back to client →</a>`;
        btn.innerHTML = '<i class="bi bi-check2 me-2"></i>Saved!';
    } catch (err) {
        banner.style.cssText = 'display:block;background:#fff0f0;border:1px solid #f0a0a0;color:#8b0000;border-radius:12px;padding:13px 18px;font-size:0.85rem;margin-bottom:24px;';
        banner.innerHTML = '<i class="bi bi-exclamation-triangle-fill me-2"></i><strong>Error:</strong> ' + err.message;
        btn.disabled  = false;
        btn.innerHTML = '<i class="bi bi-check2-circle me-2"></i>Save Changes';
    }
});
</script>

