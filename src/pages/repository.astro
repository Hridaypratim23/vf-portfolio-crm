---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';

const AVATAR_COLORS = ['#0ba882','#3b5bdb','#e8900a','#6741d9','#f15162','#0d9adb','#2d9c4e','#c2255c','#1971c2','#5c7cfa'];
function tmColor(name: string): string {
  let h = 0;
  for (let i = 0; i < name.length; i++) h = (name.charCodeAt(i) + ((h << 5) - h)) | 0;
  return AVATAR_COLORS[Math.abs(h) % AVATAR_COLORS.length];
}
function tmInitials(name: string): string {
  return name.replace(/[(&)]/g, ' ').split(/\s+/).filter(Boolean).slice(0, 2).map((w: string) => w[0]).join('').toUpperCase();
}

const salesDocs = [
  { href: 'https://vantagecircle-my.sharepoint.com/:b:/p/sneha_bhagabati/IQD30iyIiy41SqBNjvYVVwh3AVXhlIwNhoUXQK5EV0wsgiU?e=5zP50l', name: 'Vfit Sales Deck', type: 'PDF', color: '#d93025', bg: 'rgba(217,48,37,0.08)', action: 'open' },
  { href: '/docs/sales-enablement/client-onboarding-document.pdf', name: 'Client Onboarding Document', type: 'PDF', color: '#d93025', bg: 'rgba(217,48,37,0.08)', action: 'open' },
];

const cxDocs = [
  { href: '/docs/vfit-user-guide.pdf',             name: 'Vfit User Guide',           type: 'PDF',  color: '#d93025', bg: 'rgba(217,48,37,0.08)',   action: 'open'     },
  { href: '/docs/vfit-implementation-guide.pdf',   name: 'Implementation Guide',      type: 'PDF',  color: '#d93025', bg: 'rgba(217,48,37,0.08)',   action: 'open'     },
  { href: '/docs/vfit-faq.pdf',                    name: 'FAQ Document',              type: 'PDF',  color: '#d93025', bg: 'rgba(217,48,37,0.08)',   action: 'open'     },
  { href: '/docs/vfit-introduction.pdf',           name: 'Introduction to Vfit',      type: 'PDF',  color: '#d93025', bg: 'rgba(217,48,37,0.08)',   action: 'open'     },
  { href: '/docs/vfit-task-details.pdf',           name: 'Task Details',              type: 'PDF',  color: '#d93025', bg: 'rgba(217,48,37,0.08)',   action: 'open'     },
  { href: '/docs/vfit-presentation.pdf',           name: 'Vantage Fit Presentation',  type: 'PDF',  color: '#d93025', bg: 'rgba(217,48,37,0.08)',   action: 'open'     },
  { href: '/docs/vfit-sample-employee-data.csv',   name: 'Sample Employee Data',      type: 'CSV',  color: '#0f9d58', bg: 'rgba(15,157,88,0.08)',   action: 'download' },
  { href: '/docs/vfit-challenge-plan-scores.xlsx', name: 'Sample Challenge Plan',     type: 'XLSX', color: '#1e7e34', bg: 'rgba(30,126,52,0.08)',   action: 'download' },
  { href: '/docs/vfit-step-challenges.docx',       name: 'Types of Step Challenges',  type: 'DOCX', color: '#1a73e8', bg: 'rgba(26,115,232,0.08)',  action: 'download' },
];

const videoTestimonials = [
  { href: 'https://youtu.be/lJNFjACUpxE?si=dC_GLtjRFngqflBF', name: 'Landmark Group',          thumb: '/docs/video-testimonials/landmark-group.png' },
  { href: 'https://youtu.be/L_39IykL-O4?si=VjPa4k7_AricxJfe', name: 'BWC Building Society',    thumb: '/docs/video-testimonials/bwc-building-society.png' },
  { href: 'https://youtu.be/FZm24QAjB8w?si=ol09y35co8Pp44Yx', name: 'Reflex Technology Group', thumb: '/docs/video-testimonials/reflex-technology-group.png' },
];

const testimonials = [
  { pdf: '/docs/testimonials/Anunta_Tech_Testimonial.pdf',                    name: 'Anunta Tech' },
  { pdf: '/docs/testimonials/ArtKhoj_Testimonial.pdf',                        name: 'ArtKhoj' },
  { pdf: '/docs/testimonials/ArtKhoj1_Testimonial.pdf',                       name: 'ArtKhoj (2)' },
  { pdf: '/docs/testimonials/Artkhoj_2_Testimonial.pdf',                      name: 'ArtKhoj (3)' },
  { pdf: '/docs/testimonials/Avalon_Consulting_Testimonial.pdf',               name: 'Avalon Consulting' },
  { pdf: '/docs/testimonials/Beroe_Testimonial.pdf',                           name: 'Beroe' },
  { pdf: '/docs/testimonials/Celegence_Testimonial.pdf',                       name: 'Celegence' },
  { pdf: '/docs/testimonials/Checkmarx_Testimonial.pdf',                       name: 'Checkmarx' },
  { pdf: '/docs/testimonials/Coach_Pyry_Testimonial.pdf',                      name: 'Coach Pyry' },
  { pdf: '/docs/testimonials/Compare_and_ConnectTestimonial.pdf',              name: 'Compare and Connect' },
  { pdf: '/docs/testimonials/Dudley_Building_SocietyTestimonial.pdf',          name: 'Dudley Building Society' },
  { pdf: '/docs/testimonials/EngagedlyTestimonial.pdf',                        name: 'Engagedly' },
  { pdf: '/docs/testimonials/Grid_India_testimonial.pdf',                      name: 'Grid India' },
  { pdf: '/docs/testimonials/Heidrick_and_Struggles_Testimonial.pdf',          name: 'Heidrick & Struggles' },
  { pdf: '/docs/testimonials/ISKL_Testimonial.pdf',                            name: 'ISKL' },
  { pdf: '/docs/testimonials/Keva_Flavours_Testimonial.pdf',                   name: 'Keva Flavours' },
  { pdf: '/docs/testimonials/Marinus_Pharma_Testimonial.pdf',                  name: 'Marinus Pharma' },
  { pdf: '/docs/testimonials/Mindsprint_-_Testimonial.pdf',                    name: 'Mindsprint' },
  { pdf: '/docs/testimonials/Momentum_Testimonial.pdf',                        name: 'Momentum' },
  { pdf: '/docs/testimonials/Niche_TechnologyTestimonial.pdf',                 name: 'Niche Technology' },
  { pdf: '/docs/testimonials/RTG_Testimonial.pdf',                             name: 'RTG' },
  { pdf: '/docs/testimonials/Ruby_Digital_Solution_Testimonial.pdf',           name: 'Ruby Digital Solution' },
  { pdf: '/docs/testimonials/Teva_Testimonial_for_Vantage_Fit_16102025.pdf',   name: 'Teva' },
  { pdf: '/docs/testimonials/Valeo_Testimonial.pdf',                           name: 'Valeo' },
  { pdf: '/docs/testimonials/Wipro_Testimonialdocx.pdf',                       name: 'Wipro' },
];
---

<BaseLayout title="Repository">

<div class="page-topbar">
  <a href="/" class="back-link"><i class="bi bi-arrow-left"></i> <span>Dashboard</span></a>
  <div style="width:1px;height:24px;background:#eee;"></div>
  <p class="page-title mb-0">Document Repository</p>
</div>

<div class="repo-page">
<div class="repo-wrap">

  <!-- ══════════════════════════════════════
       VIEW A — Folder list (default)
  ══════════════════════════════════════════ -->
  <div id="view-root">

    <p class="repo-caption">{salesDocs.length + cxDocs.length + testimonials.length} documents &middot; 3 folders</p>

    <div class="folders-grid">

      <!-- Folder: CX Onboarding Kit -->
      <button class="folder-card" onclick="openView('cx')">
        <div class="fc-icon fc-amber">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M3 7C3 5.9 3.9 5 5 5H9.586a1 1 0 0 1 .707.293l1.414 1.414A1 1 0 0 0 12.414 7H19a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7z" fill="currentColor" opacity=".25"/>
            <path d="M3 9C3 7.9 3.9 7 5 7H19a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V9z" fill="currentColor"/>
          </svg>
        </div>
        <div class="fc-body">
          <span class="fc-name">CX Onboarding Kit</span>
          <span class="fc-desc">Guides, templates &amp; data files</span>
        </div>
        <div class="fc-foot">
          <span class="fc-count">{cxDocs.length} files</span>
          <span class="fc-open-lbl">Open <svg width="13" height="13" viewBox="0 0 16 16" fill="currentColor"><path fill-rule="evenodd" d="M4.646 1.646a.5.5 0 0 1 .708 0l6 6a.5.5 0 0 1 0 .708l-6 6a.5.5 0 0 1-.708-.708L10.293 8 4.646 2.354a.5.5 0 0 1 0-.708z"/></svg></span>
        </div>
      </button>

      <!-- Folder: Sales Enablement -->
      <button class="folder-card" onclick="openView('sales')">
        <div class="fc-icon fc-teal">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M3 7C3 5.9 3.9 5 5 5H9.586a1 1 0 0 1 .707.293l1.414 1.414A1 1 0 0 0 12.414 7H19a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7z" fill="currentColor" opacity=".25"/>
            <path d="M3 9C3 7.9 3.9 7 5 7H19a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V9z" fill="currentColor"/>
          </svg>
        </div>
        <div class="fc-body">
          <span class="fc-name">Sales Enablement</span>
          <span class="fc-desc">Sales deck &amp; onboarding documents</span>
        </div>
        <div class="fc-foot">
          <span class="fc-count">{salesDocs.length} files</span>
          <span class="fc-open-lbl">Open <svg width="13" height="13" viewBox="0 0 16 16" fill="currentColor"><path fill-rule="evenodd" d="M4.646 1.646a.5.5 0 0 1 .708 0l6 6a.5.5 0 0 1 0 .708l-6 6a.5.5 0 0 1-.708-.708L10.293 8 4.646 2.354a.5.5 0 0 1 0-.708z"/></svg></span>
        </div>
      </button>

      <!-- Folder: Testimonials -->
      <button class="folder-card" onclick="openView('tm')">
        <div class="fc-icon fc-indigo">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M3 7C3 5.9 3.9 5 5 5H9.586a1 1 0 0 1 .707.293l1.414 1.414A1 1 0 0 0 12.414 7H19a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7z" fill="currentColor" opacity=".25"/>
            <path d="M3 9C3 7.9 3.9 7 5 7H19a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V9z" fill="currentColor"/>
          </svg>
        </div>
        <div class="fc-body">
          <span class="fc-name">Client Testimonials</span>
          <span class="fc-desc">Signed letters from Vantage Fit clients</span>
        </div>
        <div class="fc-foot">
          <span class="fc-count">{testimonials.length} files</span>
          <span class="fc-open-lbl">Open <svg width="13" height="13" viewBox="0 0 16 16" fill="currentColor"><path fill-rule="evenodd" d="M4.646 1.646a.5.5 0 0 1 .708 0l6 6a.5.5 0 0 1 0 .708l-6 6a.5.5 0 0 1-.708-.708L10.293 8 4.646 2.354a.5.5 0 0 1 0-.708z"/></svg></span>
        </div>
      </button>

    </div>
  </div>

  <!-- ══════════════════════════════════════
       VIEW D — Sales Enablement contents
  ══════════════════════════════════════════ -->
  <div id="view-sales" style="display:none;">

    <div class="view-nav">
      <button class="view-back" onclick="closeView()">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path fill-rule="evenodd" d="M11.354 1.646a.5.5 0 0 1 0 .708L5.707 8l5.647 5.646a.5.5 0 0 1-.708.708l-6-6a.5.5 0 0 1 0-.708l6-6a.5.5 0 0 1 .708 0z"/></svg>
        All folders
      </button>
      <div class="view-crumb">
        <span class="crumb-sep">/</span>
        <span class="crumb-current">Sales Enablement</span>
      </div>
    </div>

    <div class="content-card">
      <div class="content-hdr">
        <div class="ch-icon ch-teal">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M3 9C3 7.9 3.9 7 5 7H19a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V9z" fill="currentColor"/></svg>
        </div>
        <span class="ch-title">Sales Enablement</span>
        <span class="ch-count">{salesDocs.length} files</span>
      </div>
      <div class="doc-list">
        {salesDocs.map(doc => (
        <a
          href={doc.href}
          target="_blank"
          rel="noopener"
          class="doc-row"
        >
          <div class="doc-type-box" style={`background:${doc.bg};color:${doc.color};`}>
            {doc.type}
          </div>
          <span class="doc-name">{doc.name}</span>
          <span class="doc-action-btn">
            <svg width="12" height="12" viewBox="0 0 16 16" fill="currentColor"><path d="M8.636 3.5a.5.5 0 0 0-.5-.5H1.5A1.5 1.5 0 0 0 0 4.5v10A1.5 1.5 0 0 0 1.5 16h10a1.5 1.5 0 0 0 1.5-1.5V7.864a.5.5 0 0 0-1 0V14.5a.5.5 0 0 1-.5.5h-10a.5.5 0 0 1-.5-.5v-10a.5.5 0 0 1 .5-.5h6.636a.5.5 0 0 0 .5-.5z"/><path d="M16 .5a.5.5 0 0 0-.5-.5h-5a.5.5 0 0 0 0 1h3.793L6.146 9.146a.5.5 0 1 0 .708.708L15 1.707V5.5a.5.5 0 0 0 1 0v-5z"/></svg> Open
          </span>
        </a>
        ))}
      </div>
    </div>

  </div>

  <!-- ══════════════════════════════════════
       VIEW B — CX Onboarding Kit contents
  ══════════════════════════════════════════ -->
  <div id="view-cx" style="display:none;">

    <div class="view-nav">
      <button class="view-back" onclick="closeView()">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path fill-rule="evenodd" d="M11.354 1.646a.5.5 0 0 1 0 .708L5.707 8l5.647 5.646a.5.5 0 0 1-.708.708l-6-6a.5.5 0 0 1 0-.708l6-6a.5.5 0 0 1 .708 0z"/></svg>
        All folders
      </button>
      <div class="view-crumb">
        <span class="crumb-sep">/</span>
        <span class="crumb-current">CX Onboarding Kit</span>
      </div>
    </div>

    <div class="content-card">
      <div class="content-hdr">
        <div class="ch-icon ch-amber">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M3 9C3 7.9 3.9 7 5 7H19a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V9z" fill="currentColor"/></svg>
        </div>
        <span class="ch-title">CX Onboarding Kit</span>
        <span class="ch-count">{cxDocs.length} files</span>
      </div>
      <div class="doc-list">
        {cxDocs.map(doc => (
        <a
          href={doc.href}
          target={doc.action === 'open' ? '_blank' : undefined}
          rel={doc.action === 'open' ? 'noopener' : undefined}
          download={doc.action === 'download' ? '' : undefined}
          class="doc-row"
        >
          <div class="doc-type-box" style={`background:${doc.bg};color:${doc.color};`}>
            {doc.type}
          </div>
          <span class="doc-name">{doc.name}</span>
          <span class="doc-action-btn">
            {doc.action === 'open'
              ? <><svg width="12" height="12" viewBox="0 0 16 16" fill="currentColor"><path d="M8.636 3.5a.5.5 0 0 0-.5-.5H1.5A1.5 1.5 0 0 0 0 4.5v10A1.5 1.5 0 0 0 1.5 16h10a1.5 1.5 0 0 0 1.5-1.5V7.864a.5.5 0 0 0-1 0V14.5a.5.5 0 0 1-.5.5h-10a.5.5 0 0 1-.5-.5v-10a.5.5 0 0 1 .5-.5h6.636a.5.5 0 0 0 .5-.5z"/><path d="M16 .5a.5.5 0 0 0-.5-.5h-5a.5.5 0 0 0 0 1h3.793L6.146 9.146a.5.5 0 1 0 .708.708L15 1.707V5.5a.5.5 0 0 0 1 0v-5z"/></svg> Open</>
              : <><svg width="12" height="12" viewBox="0 0 16 16" fill="currentColor"><path d="M.5 9.9a.5.5 0 0 1 .5.5v2.5a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-2.5a.5.5 0 0 1 1 0v2.5a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2v-2.5a.5.5 0 0 1 .5-.5z"/><path d="M7.646 11.854a.5.5 0 0 0 .708 0l3-3a.5.5 0 0 0-.708-.708L8.5 10.293V1.5a.5.5 0 0 0-1 0v8.793L5.354 8.146a.5.5 0 1 0-.708.708l3 3z"/></svg> Download</>
            }
          </span>
        </a>
        ))}
      </div>
    </div>

  </div>

  <!-- ══════════════════════════════════════
       VIEW C — Testimonials contents
  ══════════════════════════════════════════ -->
  <div id="view-tm" style="display:none;">

    <div class="view-nav">
      <button class="view-back" onclick="closeView()">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path fill-rule="evenodd" d="M11.354 1.646a.5.5 0 0 1 0 .708L5.707 8l5.647 5.646a.5.5 0 0 1-.708.708l-6-6a.5.5 0 0 1 0-.708l6-6a.5.5 0 0 1 .708 0z"/></svg>
        All folders
      </button>
      <div class="view-crumb">
        <span class="crumb-sep">/</span>
        <span class="crumb-current">Client Testimonials</span>
      </div>
    </div>

    <div class="content-card" style="margin-bottom:14px;">
      <div class="content-hdr">
        <div class="ch-icon ch-red">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M10 8l6 4-6 4V8z" fill="currentColor"/><path d="M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0z" stroke="currentColor" stroke-width="1.8" fill="none"/></svg>
        </div>
        <span class="ch-title">Video Testimonials</span>
        <span class="ch-count">{videoTestimonials.length} videos</span>
      </div>
      <div class="vid-grid">
        {videoTestimonials.map(v => (
          <a href={v.href} target="_blank" rel="noopener" class="vid-card">
            <div class="vid-thumb-wrap">
              <img src={v.thumb} alt={v.name} class="vid-thumb" />
              <div class="vid-play-overlay">
                <div class="vid-play-btn">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                </div>
              </div>
              <div class="vid-gradient"></div>
              <span class="vid-name">{v.name}</span>
            </div>
          </a>
        ))}
      </div>
    </div>

    <div class="content-card">
      <div class="content-hdr">
        <div class="ch-icon ch-indigo">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M3 9C3 7.9 3.9 7 5 7H19a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V9z" fill="currentColor"/></svg>
        </div>
        <span class="ch-title">Text Testimonials</span>
        <span class="ch-count">{testimonials.length} files</span>
        <div class="tm-search-wrap">
          <svg class="tm-search-ico" width="13" height="13" viewBox="0 0 16 16" fill="currentColor"><path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.099zm-5.242 1.656a5.5 5.5 0 1 1 0-11 5.5 5.5 0 0 1 0 11z"/></svg>
          <input id="tmSearch" class="tm-search" placeholder="Search company…" autocomplete="off" />
        </div>
        <span id="tmCount" class="ch-count ch-count-right">{testimonials.length} results</span>
      </div>

      <div class="tm-grid" id="tmGrid">
        {testimonials.map(t => (
        <a href={t.pdf} target="_blank" rel="noopener" class="tm-card" data-name={t.name.toLowerCase()}>
          <div class="tm-av" style={`background:${tmColor(t.name)}`}>{tmInitials(t.name)}</div>
          <span class="tm-company">{t.name}</span>
          <svg class="tm-arrow" width="12" height="12" viewBox="0 0 16 16" fill="currentColor"><path fill-rule="evenodd" d="M4.646 1.646a.5.5 0 0 1 .708 0l6 6a.5.5 0 0 1 0 .708l-6 6a.5.5 0 0 1-.708-.708L10.293 8 4.646 2.354a.5.5 0 0 1 0-.708z"/></svg>
        </a>
        ))}
      </div>

      <div id="tmEmpty" class="tm-empty" style="display:none;">
        <p>No companies match your search.</p>
      </div>
    </div>

  </div>

</div><!-- /repo-wrap -->
</div><!-- /repo-page -->

<style>
/* ── Page shell ──────────────────────────────────────────────── */
.repo-page {
  background: #f3f4f8;
  min-height: calc(100vh - 56px);
  padding-bottom: 60px;
}
.repo-wrap {
  max-width: 900px;
  margin: 0 auto;
  padding: 26px 20px 0;
}
.repo-caption {
  font-size: 0.72rem;
  color: #9098a8;
  margin: 0 0 14px 2px;
}

/* ══ Folder list grid ═════════════════════════════════════════ */
.folders-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  gap: 14px;
}

/* ── Folder card ─────────────────────────────────────────────── */
.folder-card {
  background: #fff;
  border: 1.5px solid #e2e6f2;
  border-radius: 18px;
  padding: 26px 22px 20px;
  cursor: pointer;
  display: flex;
  flex-direction: column;
  gap: 14px;
  text-align: left;
  transition: border-color 0.17s, box-shadow 0.17s, transform 0.17s;
  box-shadow: 0 1px 4px rgba(0,0,0,0.05);
}
.folder-card:hover {
  border-color: #7b97fb;
  box-shadow: 0 6px 28px rgba(74,99,224,0.12);
  transform: translateY(-2px);
}
.folder-card:active { transform: translateY(0); }

.fc-icon {
  width: 60px; height: 60px;
  border-radius: 16px;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.fc-amber {
  background: linear-gradient(140deg, #fff3cc, #ffe98c);
  color: #b87a00;
  border: 1px solid #fcd66e;
}
.fc-indigo {
  background: linear-gradient(140deg, #eef0ff, #d8e0ff);
  color: #4a63e0;
  border: 1px solid #b0c2ff;
}
.fc-teal {
  background: linear-gradient(140deg, #d8f5ef, #a8edd9);
  color: #0ba882;
  border: 1px solid #7dd9c0;
}

.fc-body { flex: 1; }
.fc-name {
  display: block;
  font-size: 0.98rem; font-weight: 700;
  color: #111827;
  margin-bottom: 5px;
}
.fc-desc {
  font-size: 0.72rem;
  color: #9098a8;
  line-height: 1.4;
}

.fc-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.fc-count {
  font-size: 0.7rem; font-weight: 600;
  color: #b0b8cc;
  background: #f2f4f9;
  border-radius: 20px;
  padding: 3px 10px;
}
.fc-open-lbl {
  display: flex; align-items: center; gap: 4px;
  font-size: 0.73rem; font-weight: 700;
  color: #4a63e0;
}

/* ══ Folder view nav (breadcrumb + back) ═════════════════════ */
.view-nav {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 14px;
}
.view-back {
  display: flex; align-items: center; gap: 6px;
  font-size: 0.78rem; font-weight: 600;
  color: #4a63e0;
  background: rgba(74,99,224,0.08);
  border: none; border-radius: 8px;
  padding: 6px 12px;
  cursor: pointer;
  transition: background 0.13s;
}
.view-back:hover { background: rgba(74,99,224,0.14); }

.view-crumb {
  display: flex; align-items: center; gap: 6px;
