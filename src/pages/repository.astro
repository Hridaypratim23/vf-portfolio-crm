/* ══ Content card ════════════════════════════════════════════ */
.content-card {
  background: #fff;
  border: 1px solid #e2e6f2;
  border-radius: 16px;
  overflow: hidden;
  box-shadow: 0 1px 4px rgba(0,0,0,0.05);
}

/* ── Content header row ─────────────────────────────────────── */
.content-hdr {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 15px 20px;
  border-bottom: 1px solid #f0f2f8;
  flex-wrap: wrap;
}
.ch-icon {
  width: 32px; height: 32px;
  border-radius: 8px;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.ch-amber { background: rgba(184,122,0,0.10); color: #b87a00; }
.ch-indigo { background: rgba(74,99,224,0.10); color: #4a63e0; }
.ch-teal  { background: rgba(11,168,130,0.10); color: #0ba882; }
.ch-red   { background: rgba(217,45,74,0.10);  color: #d92d4a; }
.ch-title {
  font-size: 0.88rem; font-weight: 700;
  color: #111827; flex: 1;
}
.ch-count {
  font-size: 0.67rem; font-weight: 600;
  color: #9098a8;
  background: #f2f4f9;
  border-radius: 20px;
  padding: 3px 10px;
  white-space: nowrap;
}
.ch-count-right { margin-left: auto; }

/* ══ Document list (CX) ══════════════════════════════════════ */
.doc-list { padding: 4px 0; }

.doc-row {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 13px 20px;
  text-decoration: none !important;
  border-bottom: 1px solid #f4f5fb;
  transition: background 0.12s;
}
.doc-row:last-child { border-bottom: none; }
.doc-row:hover { background: #f8f9ff; }

.doc-type-box {
  width: 42px; height: 32px;
  border-radius: 7px;
  display: flex; align-items: center; justify-content: center;
  font-size: 0.56rem; font-weight: 900;
  letter-spacing: 0.06em;
  flex-shrink: 0;
}
.doc-name {
  flex: 1;
  font-size: 0.855rem; font-weight: 600;
  color: #1a2535;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.doc-action-btn {
  display: flex; align-items: center; gap: 5px;
  font-size: 0.72rem; font-weight: 700;
  color: #4a63e0;
  background: rgba(74,99,224,0.07);
  border-radius: 8px;
  padding: 5px 12px;
  white-space: nowrap;
  flex-shrink: 0;
  transition: background 0.13s;
}
.doc-row:hover .doc-action-btn { background: rgba(74,99,224,0.13); }

/* ══ Video testimonials ══════════════════════════════════════ */
.vid-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12px;
  padding: 16px;
}
.vid-card {
  display: block;
  text-decoration: none !important;
  border-radius: 14px;
  overflow: hidden;
  border: none;
  box-shadow: 0 2px 12px rgba(0,0,0,0.10);
  transition: box-shadow 0.18s, transform 0.18s;
}
.vid-card:hover {
  box-shadow: 0 8px 32px rgba(0,0,0,0.18);
  transform: translateY(-3px);
}
.vid-thumb-wrap {
  position: relative;
  aspect-ratio: 16/9;
  overflow: hidden;
  background: #111;
}
.vid-thumb {
  width: 100%; height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.22s;
}
.vid-card:hover .vid-thumb { transform: scale(1.04); }
.vid-play-overlay {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}
.vid-play-btn {
  width: 54px; height: 54px;
  background: rgba(255,255,255,0.92);
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  color: #e00;
  box-shadow: 0 4px 20px rgba(0,0,0,0.30);
  transition: transform 0.18s, background 0.18s;
  padding-left: 4px;
}
.vid-card:hover .vid-play-btn {
  transform: scale(1.12);
  background: #fff;
}
.vid-gradient {
  position: absolute;
  bottom: 0; left: 0; right: 0;
  height: 52%;
  background: linear-gradient(to top, rgba(0,0,0,0.68) 0%, transparent 100%);
  pointer-events: none;
}
.vid-name {
  position: absolute;
  bottom: 11px; left: 13px; right: 13px;
  font-size: 0.82rem; font-weight: 700;
  color: #fff;
  letter-spacing: 0.01em;
  text-shadow: 0 1px 4px rgba(0,0,0,0.5);
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}

/* ══ Testimonial grid ════════════════════════════════════════ */
.tm-search-wrap {
  position: relative;
  flex: 1;
  min-width: 160px;
  max-width: 260px;
}
.tm-search-ico {
  position: absolute;
  left: 10px; top: 50%;
  transform: translateY(-50%);
  color: #b8c0d4;
  pointer-events: none;
}
.tm-search {
  width: 100%;
  border: 1.5px solid #e4e8f2;
  border-radius: 9px;
  padding: 7px 12px 7px 30px;
  font-size: 0.78rem; color: #1a2535;
  background: #f6f8fc;
  outline: none;
  font-family: inherit;
  transition: border-color 0.14s, background 0.14s, box-shadow 0.14s;
}
.tm-search:focus {
  border-color: #4a63e0;
  background: #fff;
  box-shadow: 0 0 0 3px rgba(74,99,224,0.09);
}

.tm-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  padding: 14px;
  gap: 8px;
}
.tm-card {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 11px 13px;
  background: #fafbfd;
  border: 1.5px solid #eaecf4;
  border-radius: 11px;
  text-decoration: none !important;
  transition: border-color 0.14s, background 0.14s, box-shadow 0.14s;
}
.tm-card:hover {
  border-color: #9ab0ff;
  background: #f4f6ff;
  box-shadow: 0 3px 14px rgba(74,99,224,0.10);
}
.tm-av {
  width: 36px; height: 36px;
  border-radius: 9px;
  display: flex; align-items: center; justify-content: center;
  font-size: 0.63rem; font-weight: 800;
  color: #fff; flex-shrink: 0;
  letter-spacing: 0.02em;
}
.tm-company {
  flex: 1;
  font-size: 0.79rem; font-weight: 600;
  color: #111827;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.tm-arrow {
  color: #c8d0e4;
  flex-shrink: 0;
  transition: color 0.13s;
}
.tm-card:hover .tm-arrow { color: #4a63e0; }
.tm-card.hidden { display: none; }

.tm-empty {
  text-align: center;
  padding: 36px 20px;
  font-size: 0.82rem;
  color: #9098a8;
}

/* ── Responsive ─────────────────────────────────────────────── */
@media (max-width: 767px) {
  .repo-wrap { padding: 16px 12px 0; }
  .folders-grid { grid-template-columns: 1fr; }
  .folder-card { flex-direction: row; align-items: center; padding: 18px 16px; gap: 14px; }
  .fc-icon { width: 48px; height: 48px; border-radius: 13px; }
  .fc-body { flex: 1; }
  .fc-foot { flex-direction: column; align-items: flex-end; gap: 4px; }
  .vid-grid { grid-template-columns: repeat(2, 1fr); gap: 10px; padding: 12px; }
  .tm-grid { grid-template-columns: repeat(2, 1fr); padding: 10px; gap: 7px; }
  .content-hdr { gap: 8px; }
  .tm-search-wrap { min-width: 100%; order: 10; }
}
@media (max-width: 440px) {
  .vid-grid { grid-template-columns: 1fr; }
  .tm-grid { grid-template-columns: 1fr; }
}
</style>

<script is:inline>
(function () {
  var root      = document.getElementById('view-root');
  var viewCx    = document.getElementById('view-cx');
  var viewTm    = document.getElementById('view-tm');
  var viewSales = document.getElementById('view-sales');

  window.openView = function (which) {
    root.style.display      = 'none';
    viewCx.style.display    = which === 'cx'    ? 'block' : 'none';
    viewTm.style.display    = which === 'tm'    ? 'block' : 'none';
    viewSales.style.display = which === 'sales' ? 'block' : 'none';
    window.scrollTo(0, 0);
  };
  window.closeView = function () {
    root.style.display      = 'block';
    viewCx.style.display    = 'none';
    viewTm.style.display    = 'none';
    viewSales.style.display = 'none';
    window.scrollTo(0, 0);
  };

  /* testimonial search */
  var searchEl = document.getElementById('tmSearch');
  var countEl  = document.getElementById('tmCount');
  var emptyEl  = document.getElementById('tmEmpty');
  if (searchEl) {
    searchEl.addEventListener('input', function () {
      var q = this.value.trim().toLowerCase();
      var cards = document.querySelectorAll('#tmGrid .tm-card');
      var n = 0;
      cards.forEach(function (c) {
        var show = !q || c.dataset.name.includes(q);
        c.classList.toggle('hidden', !show);
        if (show) n++;
      });
      if (countEl) countEl.textContent = n + ' result' + (n === 1 ? '' : 's');
      if (emptyEl) emptyEl.style.display = n === 0 ? 'block' : 'none';
    });
  }
})();
</script>

</BaseLayout>