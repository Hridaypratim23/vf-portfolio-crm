<script is:inline>
  // ── IST clock (date + time) ────────────────────────────────────────
  (function() {
    const el = document.getElementById('ist-date');
    if (!el) return;
    function update() {
      const now = new Date();
      const date = now.toLocaleDateString('en-GB', { weekday:'short', day:'2-digit', month:'short', year:'numeric', timeZone:'Asia/Kolkata' });
      const time = now.toLocaleTimeString('en-GB', { hour:'2-digit', minute:'2-digit', timeZone:'Asia/Kolkata' });
      el.textContent = date + ' · ' + time + ' IST';
    }
    update();
    setInterval(update, 60000);
  })();

  // ── Count-up animation ────────────────────────────────────────────
  (function() {
    function animateCountUp(el) {
      const target = parseInt(el.dataset.target || el.textContent.replace(/[^0-9]/g,''), 10);
      if (!target || isNaN(target)) return;
      const duration = 700;
      const start    = performance.now();
      const isMoney  = el.textContent.includes('$');
      function fmt(n) {
        if (isMoney) return '$' + new Intl.NumberFormat('en-US').format(Math.round(n));
        return String(Math.round(n));
      }
      function step(ts) {
        const progress = Math.min((ts - start) / duration, 1);
        const ease     = 1 - Math.pow(1 - progress, 3); // ease-out cubic
        el.textContent = fmt(ease * target);
        if (progress < 1) requestAnimationFrame(step);
        else el.textContent = fmt(target);
      }
      requestAnimationFrame(step);
    }
    document.addEventListener('DOMContentLoaded', function() {
      const io = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) {
            animateCountUp(entry.target);
            io.unobserve(entry.target);
          }
        });
      });
      document.querySelectorAll('.count-up').forEach(function(el) { io.observe(el); });
    });
  })();
</script>

<script is:inline define:vars={{ clientSearchList }}>
(function() {
  const clients = JSON.parse(clientSearchList);
  // Expose to command palette
  window._cmdClients = clients;
  const input   = document.getElementById('smartSearchInput');
  const box     = document.getElementById('searchSuggestions');
  if (!input || !box) return;

  let active = -1;

  function show(items) {
    if (!items.length) { box.style.display = 'none'; return; }
    box.innerHTML = items.slice(0, 8).map((c, i) =>
      `<div class="ss-item" data-id="${c.id}" data-idx="${i}">
        <span class="ss-name">${highlight(c.name, input.value)}</span>
        <span class="ss-status">${c.status || ''}</span>
      </div>`
    ).join('');
    box.style.display = 'block';
    active = -1;
    box.querySelectorAll('.ss-item').forEach(function(el) {
      el.addEventListener('mousedown', function(e) {
        e.preventDefault();
        window.location.href = '/client/' + el.dataset.id + '?back=%2F';
      });
    });
  }

  function highlight(name, q) {
    if (!q) return name;
    const idx = name.toLowerCase().indexOf(q.toLowerCase());
    if (idx === -1) return name;
    return name.slice(0, idx) +
      '<strong>' + name.slice(idx, idx + q.length) + '</strong>' +
      name.slice(idx + q.length);
  }

  input.addEventListener('input', function() {
    const q = this.value.trim();
    if (!q) { box.style.display = 'none'; return; }
    const matches = clients.filter(c => c.name.toLowerCase().includes(q.toLowerCase()));
    show(matches);
  });

  input.addEventListener('keydown', function(e) {
    const items = box.querySelectorAll('.ss-item');
    if (!items.length) return;
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      active = Math.min(active + 1, items.length - 1);
      items.forEach((el, i) => el.classList.toggle('ss-active', i === active));
      items[active].scrollIntoView({ block: 'nearest' });
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      active = Math.max(active - 1, -1);
      items.forEach((el, i) => el.classList.toggle('ss-active', i === active));
      if (active >= 0) items[active].scrollIntoView({ block: 'nearest' });
    } else if (e.key === 'Enter' && active >= 0) {
      e.preventDefault();
      window.location.href = '/client/' + items[active].dataset.id + '?back=%2F';
    } else if (e.key === 'Escape') {
      box.style.display = 'none';
    }
  });

  document.addEventListener('click', function(e) {
    if (!input.contains(e.target) && !box.contains(e.target))
      box.style.display = 'none';
  });
})();
</script>
