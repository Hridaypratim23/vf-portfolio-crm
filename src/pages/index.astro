---
import BaseLayout from '../layouts/BaseLayout.astro';

import {
  parseDate, fyOfDate, currentFY, fyLabel, isSubscription, isOnetime,
  isMultiyear, prorateCvForFy, buildFyBreakdown, getLiveFxRates
} from '../lib/revenue';


// ── Helpers ─────────────────────────────────────────────────────────────────

function parseActiveMonths(s: string): number[] {
  if (!s) return [];
  const parts = s.replace(/\//g, ',').split(',').map(p => p.trim()).filter(Boolean);
  const MM: Record<string, number> = {
    january:1,jan:1,february:2,feb:2,march:3,mar:3,april:4,apr:4,may:5,
    june:6,jun:6,july:7,jul:7,august:8,aug:8,september:9,sep:9,sept:9,
    october:10,oct:10,november:11,nov:11,december:12,dec:12
  };
  return parts.map(p => MM[p.toLowerCase()]).filter(Boolean);
}

function nextActiveMonthDate(s: string, today: Date): Date | null {
  const months = parseActiveMonths(s);
  if (!months.length) return null;
  let soonest: Date | null = null;
  for (const mo of months) {
    let candidate = new Date(today.getFullYear(), mo - 1, 1);
    const diffDays = (today.getTime() - candidate.getTime()) / 86400000;
    if (diffDays > 20) candidate = new Date(today.getFullYear() + 1, mo - 1, 1);
    if (!soonest || candidate < soonest) soonest = candidate;
  }
  return soonest;
}

function nextRerunDate(start: Date, today: Date): Date {
  let candidate = new Date(today.getFullYear(), start.getMonth(), start.getDate());
  const diffDays = (today.getTime() - candidate.getTime()) / 86400000;
  if (diffDays > 20) candidate = new Date(today.getFullYear() + 1, start.getMonth(), start.getDate());
  return candidate;
}

function generateInsights(clients: any[], today: Date) {
  const insights: any[] = [];

  const subsDue: any[] = [];
  for (const c of clients) {
    if (isSubscription(c.type || '')) {
      const end = parseDate(c.agreement_end_date);
      if (end) {
        const d = (end.getTime() - today.getTime()) / 86400000;
        if (d >= 0 && d <= 30) subsDue.push({ name: c.company_name, id: c.id, days: d });
      }
    }
  }
  if (subsDue.length) {
    subsDue.sort((a, b) => a.days - b.days);
    const priority = subsDue.some(x => x.days <= 7) ? 'urgent' : 'warn';
    let names = subsDue.slice(0, 2).map(x => x.name).join(', ');
    if (subsDue.length > 2) names += ` +${subsDue.length - 2} more`;
    insights.push({
      icon: 'bi-arrow-repeat', priority,
      title: `${subsDue.length} subscription${subsDue.length > 1 ? 's' : ''} renewing within 30 days`,
      body: `Send renewal notices to ${names}.`,
      link: '/renewals?days=30', link_text: 'Open Renewals',
    });
  }

  const overdue: any[] = [];
  for (const c of clients) {
    if (isSubscription(c.type || '')) {
      const end = parseDate(c.agreement_end_date);
      if (end && (end.getTime() - today.getTime()) / 86400000 < -1) overdue.push({ name: c.company_name, id: c.id });
    }
  }
  if (overdue.length) {
    let names = overdue.slice(0, 2).map(x => x.name).join(', ');
    if (overdue.length > 2) names += ` +${overdue.length - 2} more`;
    insights.push({
      icon: 'bi-exclamation-triangle-fill', priority: 'urgent',
      title: `${overdue.length} subscription${overdue.length > 1 ? 's' : ''} past expiry — act now`,
      body: `Agreements have lapsed: ${names}. Prioritise recovery.`,
      link: '/renewals', link_text: 'View Overdue',
    });
  }

  const live: any[] = [];
  for (const c of clients) {
    if (isOnetime(c.type || '')) {
      const am = c.active_month || null;
      let rerun: Date | null = null;
      if (am) rerun = nextActiveMonthDate(am, today);
      else { const start = parseDate(c.agreement_start_date); if (start) rerun = nextRerunDate(start, today); }
      if (rerun) {
        const d = (rerun.getTime() - today.getTime()) / 86400000;
        if (d >= -10 && d <= 5) live.push({ name: c.company_name, id: c.id });
      }
    }
  }
  if (live.length) {
    let names = live.slice(0, 2).map(x => x.name).join(', ');
    if (live.length > 2) names += ` +${live.length - 2} more`;
    insights.push({
      icon: 'bi-lightning-charge-fill', priority: 'warn',
      title: `${live.length} client${live.length > 1 ? 's' : ''} in active campaign window`,
      body: `Campaign window is open for ${names}. Send proposals today.`,
      link: '/renewals#rerun', link_text: 'View Pipeline',
    });
  }

  const upcoming: any[] = [];
  for (const c of clients) {
    if (isOnetime(c.type || '')) {
      const am = c.active_month || null;
      let rerun: Date | null = null;
      if (am) rerun = nextActiveMonthDate(am, today);
      else { const start = parseDate(c.agreement_start_date); if (start) rerun = nextRerunDate(start, today); }
      if (rerun) {
        const d = (rerun.getTime() - today.getTime()) / 86400000;
        if (d >= 6 && d <= 30) upcoming.push({ name: c.company_name, id: c.id, days: d });
      }
    }
  }
  if (upcoming.length) {
    upcoming.sort((a, b) => a.days - b.days);
    let names = upcoming.slice(0, 2).map(x => x.name).join(', ');
    if (upcoming.length > 2) names += ` +${upcoming.length - 2} more`;
    insights.push({
      icon: 'bi-calendar2-event-fill', priority: 'info',
      title: `${upcoming.length} re-run opportunit${upcoming.length > 1 ? 'ies' : 'y'} opening soon`,
      body: `Prepare outreach for ${names} — campaigns start in under 30 days.`,
      link: '/renewals#rerun', link_text: 'View Pipeline',
    });
  }

  const winback: any[] = [];
  for (const c of clients) {
    const status = c.status || '';
    if (status.includes('Inactive') && status.includes('Repeat')) {
      let emp = 0;
      try { emp = parseInt((c.employee_base || '0').split('/')[0].split('-')[0].replace(/[^0-9]/g, '')); } catch {}
      if (emp >= 300) winback.push({ name: c.company_name, id: c.id, emp });
    }
  }
  if (winback.length) {
    winback.sort((a, b) => b.emp - a.emp);
    let names = winback.slice(0, 2).map(x => x.name).join(', ');
    if (winback.length > 2) names += ` +${winback.length - 2} more`;
    insights.push({
      icon: 'bi-arrow-up-circle-fill', priority: 'info',
      title: `${winback.length} high-value repeat client${winback.length > 1 ? 's' : ''} to re-engage`,
      body: `${names} have large teams and prior campaigns — strong win-back candidates.`,
      link: '/clients', link_text: 'View Clients',
    });
  }

  return insights.slice(0, 5);
}

// ── Data fetching — FX fetch + all DB queries in one batch round-trip ─────────
const db = (Astro.locals as any).runtime.env.DB;
const [fxRates, batchResults] = await Promise.all([
  getLiveFxRates(),
  db.batch([
    db.prepare('SELECT * FROM clients ORDER BY company_name'),
    db.prepare('SELECT * FROM extra_revenue'),
    db.prepare('SELECT * FROM sub_history'),
  ]),
]) as [Record<string, number>, any[]];
const _rawClients      = batchResults[0].results as any[];
const _rawExtraRevRows = batchResults[1].results as any[];
const _rawSubHistRows  = batchResults[2].results as any[];

function toUSD(amount: number, currency: string): number {
  const rate = fxRates[(currency || 'USD').toUpperCase()] ?? 1;
  return amount / rate;
}

// India & RoW only — exclude NA (North America / Annual-type legacy) clients everywhere
const clients = _rawClients.filter((c: any) => c.region ? c.region !== 'North America' : (c.type || '') !== 'Annual');
const _indiaIds = new Set(clients.map((c: any) => c.id));
const extraRevRows = _rawExtraRevRows.filter((r: any) => _indiaIds.has(r.client_id));
const subHistRows  = _rawSubHistRows.filter((r: any)  => _indiaIds.has(r.client_id));

const clientSearchList = JSON.stringify(clients.map((c: any) => ({ id: c.id, name: c.company_name || '', status: c.status || '' })));

const today = new Date();
const todayFyStart = currentFY();

const total = clients.length;
const active = clients.filter(c => (c.status || '').includes('Active')).length;

let subRenewing30 = 0, overdueCount = 0, rerunOpps = 0;
for (const c of clients) {
  const ctype = c.type || '';
  if (isSubscription(ctype)) {
    const end = parseDate(c.agreement_end_date);
    if (end) {
      const d = (end.getTime() - today.getTime()) / 86400000;
      if (d < -1) overdueCount++;
      else if (d <= 30) subRenewing30++;
    }
  } else if (isOnetime(ctype)) {
    const am = c.active_month || null;
    let rerun: Date | null = null;
    if (am) rerun = nextActiveMonthDate(am, today);
    else { const start = parseDate(c.agreement_start_date); if (start) rerun = nextRerunDate(start, today); }
    if (rerun) {
      const d = (rerun.getTime() - today.getTime()) / 86400000;
      if (d >= -20 && d <= 90) rerunOpps++;
    }
  }
}

// Extra revenue — converted to USD
let extraLicTotalUSD = 0, extraRpTotalUSD = 0;
for (const row of (extraRevRows as any[])) {
  const amtUSD = toUSD(row.amount || 0, row.currency || 'USD');
  if (row.type === 'Additional Licenses') extraLicTotalUSD += amtUSD;
  else extraRpTotalUSD += amtUSD;
}

// Build sub_history lookup first so revClients can reference it
const subHistByClientId: Record<number, any[]> = {};
for (const r of subHistRows as any[]) {
  if (!subHistByClientId[r.client_id]) subHistByClientId[r.client_id] = [];
  subHistByClientId[r.client_id].push(r);
}

// Subscription + one-time contract values
const revClients = clients.filter(c =>
  (c.contract_value || 0) > 0 ||
  (c.manual_contract_value || 0) > 0 ||
  (subHistByClientId[c.id]?.length > 0)
);
let arr = clients
  .filter(c => isSubscription(c.type||'') || (c.type||'') === 'Annual')
  .reduce((s, c) => s + toUSD(c.contract_value || 0, c.currency || 'USD'), 0);
arr += extraLicTotalUSD;
const ot = clients
  .filter(c => isOnetime(c.type||''))
  .reduce((s, c) => s + toUSD(c.contract_value || 0, c.currency || 'USD'), 0);
const extraRpTotal = extraRpTotalUSD;
const extraLicTotal = extraLicTotalUSD;
const totalCv = arr + ot + extraRpTotal;

const revByStatus: Record<string, number> = {};
for (const c of clients) {
  if ((c.contract_value || 0) > 0) {
    const s = c.status || 'Unknown';
    revByStatus[s] = (revByStatus[s] || 0) + (c.contract_value || 0);
  }
}

// Per-FY revenue: New Clients (Sales) vs Returning Clients (CX)
// - New (Sales):      first year of a subscription OR any new one-time campaign
// - Returning (CX):   subscription renewals (year 2+), One-time Repeat campaigns, Reward Points

// Pre-compute the earliest FY each subscription client first appeared in sub_history
const firstSubFyById: Record<number, number> = {};
for (const [cid, hist] of Object.entries(subHistByClientId)) {
  const years = (hist as any[]).map((r: any) => r.financial_year as number);
  if (years.length) firstSubFyById[Number(cid)] = Math.min(...years);
}

// Build client-id → classification lookup for extra-revenue rows
const clientById: Record<number, any> = {};
for (const c of clients) clientById[c.id] = c;

const fyTypeMap: Record<string, { new: number; returning: number }> = {};

for (let fyStart = 2024; fyStart <= todayFyStart; fyStart++) {
  let newRev = 0, returnRev = 0;

  for (const c of clients) {
    const cv = c.contract_value || 0;
    const cur = c.currency || 'USD';
    const ctype = c.type || '';
    const subHist = (subHistByClientId[c.id] || []) as any[];
    const isSub = isSubscription(ctype) || ctype === 'Annual';
    const isRepeat = ctype.toLowerCase().includes('repeat');
    const isOt = isOnetime(ctype);
    let share = 0;

    if (subHist.length > 0) {
      for (const entry of subHist) {
        if (entry.financial_year === fyStart) share += toUSD(entry.amount, entry.currency);
      }
    } else if (cv > 0) {
      const fyOverride = c.contract_fy_override || null;
      if (fyOverride) {
        if (fyOverride === fyStart) share = toUSD(cv, cur);
      } else if (isSub) {
        if (isMultiyear(c.agreement_start_date, c.agreement_end_date)) {
          share = toUSD(prorateCvForFy(c.agreement_start_date, c.agreement_end_date, cv, fyStart), cur);
        } else {
          if (fyOfDate(c.agreement_start_date) === fyStart) share = toUSD(cv, cur);
        }
      } else if (isOt) {
        const startFy = fyOfDate(c.agreement_start_date) ?? fyOfDate(c.campaign_start_date);
        if (startFy === fyStart) share = toUSD(cv, cur);
      }
    }

    if (share <= 0) continue;

    if (isRepeat) {
      returnRev += share;                             // Repeat = CX = Returning
    } else if (isSub) {
      const firstFy = firstSubFyById[c.id] ?? (fyOfDate(c.agreement_start_date) ?? fyStart);
      if (fyStart <= firstFy) newRev += share;        // First year = Sales = New
      else returnRev += share;                        // Renewal = CX = Returning
    } else {
      newRev += share;                                // New one-time = Sales = New
    }
  }

  for (const row of extraRevRows as any[]) {
    let rowFy: number;
    if (row.financial_year) {
      rowFy = row.financial_year;
    } else {
      try {
        const d = new Date((row.created_at as string).slice(0, 10));
        rowFy = d.getMonth() >= 3 ? d.getFullYear() : d.getFullYear() - 1;
      } catch { continue; }
    }
    if (rowFy !== fyStart) continue;
    const amtUSD = toUSD(row.amount || 0, row.currency || 'USD');
    if (row.type === 'Additional Licenses') {
      const cl = clientById[row.client_id];
      if (cl) {
        const ct = cl.type || '';
        const clRepeat = ct.toLowerCase().includes('repeat');
        const clSub = isSubscription(ct) || ct === 'Annual';
        if (clRepeat) returnRev += amtUSD;
        else if (clSub) {
          const ff = firstSubFyById[cl.id] ?? (fyOfDate(cl.agreement_start_date) ?? fyStart);
          if (fyStart <= ff) newRev += amtUSD; else returnRev += amtUSD;
        } else newRev += amtUSD;
      } else newRev += amtUSD;
    } else {
      // Reward Points excluded from New vs Returning chart — skip
    }
  }

  fyTypeMap[fyLabel(fyStart)] = { new: Math.round(newRev), returning: Math.round(returnRev) };
}

// Lifetime
fyTypeMap['Lifetime'] = {
  new:       Object.values(fyTypeMap).reduce((s, v) => s + v.new, 0),
  returning: Object.values(fyTypeMap).reduce((s, v) => s + v.returning, 0),
};

const revByType = fyTypeMap['Lifetime'];

// Top clients chart uses contract-value-for-display logic (latest FY sub_history or raw CV)
function displayCvInfo(c: any): { usd: number; fy: number | null } {
  const hist = subHistByClientId[c.id] || [];
  if (hist.length > 0) {
    const maxFy = Math.max(...hist.map((r: any) => r.financial_year));
    const usd = hist
      .filter((r: any) => r.financial_year === maxFy)
      .reduce((s: number, r: any) => s + toUSD(r.amount || 0, r.currency || 'USD'), 0);
    return { usd, fy: maxFy };
  }
  const fallbackFy = c.contract_fy_override
    ?? fyOfDate(c.agreement_start_date)
    ?? fyOfDate(c.campaign_start_date)
    ?? null;
  return { usd: toUSD(c.contract_value || 0, c.currency || 'USD'), fy: fallbackFy };
}
const allDisplayClients = clients.filter(c => displayCvInfo(c).usd > 0);
const topRevClients = [...allDisplayClients].sort((a, b) => displayCvInfo(b).usd - displayCvInfo(a).usd).slice(0, 8);
const topActiveRevClients = [...allDisplayClients]
  .filter(c => (c.status || '').includes('Active'))
  .sort((a, b) => displayCvInfo(b).usd - displayCvInfo(a).usd)
  .slice(0, 8);

const fyBreakdown = buildFyBreakdown(clients, extraRevRows, subHistRows, todayFyStart, toUSD);

const fyBreakdownForTemplate = fyBreakdown.map(f => ({
  label: f.label,
  sub: f.sub,
  ot: f.ot,
  extra_rp: f.extraRp,
  total: f.total,
  client_count: f.clientCount,
  is_current: f.isCurrent,
}));

const currentFyEntry = fyBreakdown.find(f => f.isCurrent);
const totalRevenue = currentFyEntry?.total || 0;
const currentFyLabel = currentFyEntry?.label || '';
const currentFyRange = `Apr ${todayFyStart} – Mar ${todayFyStart + 1}`;

const pipelineLabels: string[] = [];
const renewalVals: number[] = [];
const rerunVals: number[] = [];
for (let i = 0; i < 6; i++) {
  let yr = today.getFullYear(), mo = today.getMonth() + 1 + i;
  if (mo > 12) { mo -= 12; yr++; }
  pipelineLabels.push(new Date(yr, mo - 1, 1).toLocaleDateString('en-GB', { month: 'short', year: 'numeric' }));
  renewalVals.push(0);
  rerunVals.push(0);
}
for (const c of clients) {
  const ctype = c.type || '';
  if (isSubscription(ctype)) {
    const end = parseDate(c.agreement_end_date);
    if (end) {
      const d = (end.getTime() - today.getTime()) / 86400000;
      if (d >= 0 && d <= 185) {
        const mk = end.toLocaleDateString('en-GB', { month: 'short', year: 'numeric' });
        const idx = pipelineLabels.indexOf(mk);
        if (idx !== -1) renewalVals[idx]++;
      }
    }
  } else if (isOnetime(ctype)) {
    const am = c.active_month || null;
    let rerun: Date | null = null;
    if (am) rerun = nextActiveMonthDate(am, today);
    else { const start = parseDate(c.agreement_start_date); if (start) rerun = nextRerunDate(start, today); }
    if (rerun) {
      const d = (rerun.getTime() - today.getTime()) / 86400000;
      if (d >= 0 && d <= 185) {
        const mk = rerun.toLocaleDateString('en-GB', { month: 'short', year: 'numeric' });
        const idx = pipelineLabels.indexOf(mk);
        if (idx !== -1) rerunVals[idx]++;
      }
    }
  }
}

const typeCounts: Record<string, number> = {};
const statusCounts: Record<string, number> = {};
for (const c of clients) {
  const t = c.type || 'Unknown';
  const s = c.status || 'Unknown';
  typeCounts[t] = (typeCounts[t] || 0) + 1;
  // Combine "Active (Repeat client)" into "Active" so chart matches stat bar total
  const sKey = s === 'Active (Repeat client)' ? 'Active' : s;
  statusCounts[sKey] = (statusCounts[sKey] || 0) + 1;
}

const chartTypes: Record<string, number> = {};
for (const [t, n] of Object.entries(typeCounts)) {
  const tl = t.toLowerCase().trim();
  let key: string;
  if (t.includes('Subscription') || t === 'Annual' || t === 'Annual (Partnership)') key = 'Annual';
  else if (tl === 'one time (repeat)') key = 'One time (Repeat)';
  else key = 'One time';
  chartTypes[key] = (chartTypes[key] || 0) + (n as number);
}

const chartData = {
  types: typeCounts,
  chart_types: chartTypes,
  statuses: statusCounts,
  pipeline_labels: pipelineLabels,
  renewal_vals: renewalVals,
  rerun_vals: rerunVals,
};

const lifetimeSub   = fyBreakdown.reduce((s, f) => s + f.sub,    0);
const lifetimeOt    = fyBreakdown.reduce((s, f) => s + f.ot,     0);
const lifetimeRp    = fyBreakdown.reduce((s, f) => s + f.extraRp, 0);
const lifetimeTotal = lifetimeSub + lifetimeOt;

const revenueData = {
  arr: Math.round(lifetimeSub), ot: Math.round(lifetimeOt), rp: Math.round(lifetimeRp), total: Math.round(lifetimeTotal),
  extra_rp: Math.round(lifetimeRp),
  count: revClients.length,
  by_type: revByType,
  by_type_per_fy: fyTypeMap,
  fy_type_labels: [...Object.keys(fyTypeMap).filter(k => k !== 'Lifetime').reverse(), 'Lifetime'],
  by_status: revByStatus,
  top_clients: topRevClients.map(c => {
    const info = displayCvInfo(c);
    return { name: c.company_name, value: Math.round(info.usd), fy: info.fy, currency: 'USD', status: c.status || '', id: c.id };
  }),
  top_active_clients: topActiveRevClients.map(c => {
    const info = displayCvInfo(c);
    return { name: c.company_name, value: Math.round(info.usd), fy: info.fy, currency: 'USD', status: c.status || '', id: c.id };
  }),
  fy_breakdown: fyBreakdownForTemplate,
};

const insights = generateInsights(clients, today);

// Revenue trend: current FY vs previous FY
const prevFyEntry = fyBreakdown.find(f => f.fyStart === todayFyStart - 1);
const prevFyContractTotal = prevFyEntry ? (prevFyEntry.sub + prevFyEntry.ot) : 0;
const curFyContractTotal  = currentFyEntry ? (currentFyEntry.sub + currentFyEntry.ot) : 0;
const revDeltaPct = prevFyContractTotal > 0
  ? Math.round(((curFyContractTotal - prevFyContractTotal) / prevFyContractTotal) * 100)
  : null;

// Active client trend: clients with revenue in current FY vs previous FY
const prevFyClientCount = prevFyEntry?.clientCount || 0;
const curFyClientCount  = currentFyEntry?.clientCount || 0;

const stats = {
  total,
  active,
  sub_renewing_30: subRenewing30,
  overdue: overdueCount,
  rerun_opps: rerunOpps,
  total_revenue: totalRevenue,
  current_fy_label: currentFyLabel,
  current_fy_range: currentFyRange,
  rev_delta_pct: revDeltaPct,
  prev_fy_label: prevFyEntry?.label || '',
  cur_fy_client_count: curFyClientCount,
  prev_fy_client_count: prevFyClientCount,
};

const todayStr = today.toLocaleDateString('en-GB', { weekday: 'long', day: '2-digit', month: 'long', year: 'numeric' });
const topClientsHeight = Math.max(
  revenueData.top_active_clients.length * 38 + 20,
  revenueData.top_clients.length * 38 + 20,
  160
);

function fmtMoney(n: number) { return new Intl.NumberFormat('en-US').format(Math.round(n)); }
function fmtCompact(n: number): string {
  if (n >= 1_000_000) return `$${(n / 1_000_000).toFixed(1)}M`;
  if (n >= 1_000)     return `$${Math.round(n / 1_000)}K`;
  return `$${Math.round(n)}`;
}
---

<BaseLayout title="Vantage Fit CRM">

<!-- ── Dashboard Top Bar ──────────────────────────────────── -->
<div class="dash-topbar">
    <div class="topbar-search" style="position:relative;">
        <i class="bi bi-search"></i>
        <form method="get" action="/clients" autocomplete="off" id="smartSearchForm" style="margin:0;">
            <input type="text" name="q" id="smartSearchInput" class="vfit-smart-search"
                   placeholder="Search clients, status, type…"
                   style="padding-left:34px;width:100%;" />
        </form>
        <div id="searchSuggestions" class="search-suggestions" style="display:none;"></div>
    </div>
    <div class="topbar-actions">
        <button class="cmd-trigger-hint" onclick="window._openCommandPalette && window._openCommandPalette()" title="Open command palette">
            <i class="bi bi-command"></i> <kbd>⌘K</kbd>
        </button>
