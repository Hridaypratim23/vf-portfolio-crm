            <div class="col-12 text-center py-4">
                <i class="bi bi-check-circle" style="font-size:1.6rem; color:#0ba882; display:block; margin-bottom:8px;"></i>
                <span style="color:#9ca3af; font-size:0.85rem;">No priority actions right now — you're all caught up!</span>
            </div>
            )}
        </div>
    </div>

</div>

<script is:inline src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script is:inline define:vars={{ chartData, revenueData }}>
const BRAND = {
    red: '#F15162', red2: '#F4705A', aqua: '#41D8B4',
    orange: '#FF9D57', midnight: '#29294C', steel: '#303740', gray: '#adb5bd',
};
const FONT = { family: 'Inter', size: 11 };
Chart.defaults.font = FONT;
Chart.defaults.color = '#6b7280';

function donutOptions(total, onClickFn) {
    return {
        maintainAspectRatio: false,
        cutout: '68%',
        onClick: onClickFn,
        plugins: {
            legend: { position: 'bottom', labels: { font: { family:'Inter', size:9 }, padding: 7, boxWidth: 8, boxHeight: 8 } },
            tooltip: {
                callbacks: {
                    label: ctx => ` ${ctx.label}: ${ctx.raw} client${ctx.raw !== 1 ? 's' : ''} (${Math.round(ctx.raw / total * 100)}%)`
                }
            }
        }
    };
}

{
    const st = chartData.statuses;
    const labels = Object.keys(st);
    const data   = Object.values(st);
    const total  = data.reduce((a, b) => a + b, 0);
    const colorMap = {
        'Active': BRAND.aqua, 'Active (Repeat client)': BRAND.orange,
        'Inactive': BRAND.red, 'Inactive (Repeat)': BRAND.steel, 'Churn': '#6c757d',
    };
    new Chart(document.getElementById('statusChart'), {
        type: 'doughnut',
        data: { labels, datasets: [{ data, backgroundColor: labels.map(l => colorMap[l] || BRAND.gray), borderWidth: 2, borderColor: '#fff', hoverOffset: 8 }] },
        options: donutOptions(total, (e, els) => {
            if (els.length) window.location.href = '/clients?status=' + encodeURIComponent(labels[els[0].index]);
        })
    });
    document.getElementById('statusChart').style.cursor = 'pointer';
}

{
    const ty = chartData.chart_types;
    const labels = Object.keys(ty);
    const data   = Object.values(ty);
    const total  = data.reduce((a, b) => a + b, 0);
    const palette = [BRAND.midnight, BRAND.orange, BRAND.aqua, BRAND.red, BRAND.gray];
    const typeFilterMap = { 'Annual': 'annual', 'One time': 'onetime-pure', 'One time (Repeat)': 'onetime-repeat' };
    new Chart(document.getElementById('typeChart'), {
        type: 'doughnut',
        data: { labels, datasets: [{ data, backgroundColor: labels.map((_, i) => palette[i % palette.length]), borderWidth: 2, borderColor: '#fff', hoverOffset: 8 }] },
        options: donutOptions(total, (e, els) => {
            if (els.length) {
                const lbl = labels[els[0].index];
                const f = typeFilterMap[lbl];
                window.location.href = f ? '/clients?filter=' + f : '/clients?q=' + encodeURIComponent(lbl);
            }
        })
    });
    document.getElementById('typeChart').style.cursor = 'pointer';
}

{
    const labels    = chartData.pipeline_labels;
    const subData   = chartData.renewal_vals;
    const rerunData = chartData.rerun_vals;
    new Chart(document.getElementById('renewalChart'), {
        type: 'bar',
        data: {
            labels,
            datasets: [
                { label: 'Subscription Renewals', data: subData,   backgroundColor: 'rgba(241,81,98,0.80)', borderRadius: 5, borderSkipped: false },
                { label: 'Re-run Opportunities',  data: rerunData, backgroundColor: 'rgba(65,216,180,0.75)', borderRadius: 5, borderSkipped: false },
            ]
        },
        options: {
            maintainAspectRatio: false,
            onClick: (e, els) => {
                if (els.length) {
                    const dest = els[0].datasetIndex === 0 ? '/renewals' : '/renewals#rerun';
                    window.location.href = dest;
                }
            },
            plugins: {
                legend: { position: 'bottom', labels: { font: { family:'Inter', size:9 }, padding: 7, boxWidth: 8, boxHeight: 8 } },
                tooltip: {
                    callbacks: {
                        label: ctx => ` ${ctx.raw} ${ctx.dataset.label.toLowerCase()}`,
                        title: ctx => ctx[0].label,
                    }
                }
            },
            scales: {
                x: { grid: { display: false }, ticks: { font: { family:'Inter', size:9 } } },
                y: { beginAtZero: true, ticks: { stepSize: 1, font: { family:'Inter', size:9 } }, grid: { color: 'rgba(0,0,0,0.04)' } }
            }
        }
    });
    document.getElementById('renewalChart').style.cursor = 'pointer';
}

if (revenueData.count > 0) {
    const revData = revenueData;
    const REV_FONT = { family: 'Inter', size: 10 };
    const REV_DARK = '#6b7280';

    {
        var byFy   = revData.by_type_per_fy;
        var fyLbls = revData.fy_type_labels;
        var currentFyLbl = ((revData.fy_breakdown.find(function(f){return f.is_current;}))||{}).label || fyLbls[0];
        var COLOR_NEW = '#0ba882';
        var COLOR_RET = '#29294C';

        function getSlice(fyLbl) {
            var d = byFy[fyLbl] || { new: 0, returning: 0 };
            return {
                vals:   [d['new'] || 0, d['returning'] || 0],
                labels: ['New Clients', 'Returning Clients'],
                colors: [COLOR_NEW, COLOR_RET],
            };
        }

        var curTotal = 0;
        var centerPlugin = {
            id: 'srcCenterText',
            afterDraw: function(chart) {
                var ca = chart.chartArea;
                var cx = (ca.left + ca.right) / 2;
                var cy = (ca.top + ca.bottom) / 2;
                var ctx2 = chart.ctx;
                ctx2.save();
                ctx2.textAlign = 'center'; ctx2.textBaseline = 'middle';
                var total = chart.data.datasets[0].data.reduce(function(a,b){return a+b;},0);
                ctx2.font = 'bold 15px Inter'; ctx2.fillStyle = '#29294C';
                ctx2.fillText(total >= 1000 ? '$' + (total/1000).toFixed(0) + 'K' : '$' + total.toLocaleString(), cx, cy - 9);
                ctx2.font = '600 9px Inter'; ctx2.fillStyle = '#9090a8';
                ctx2.fillText('TOTAL REVENUE', cx, cy + 9);
                ctx2.restore();
            }
        };

        var initSlice = getSlice(currentFyLbl);
        curTotal = initSlice.vals.reduce(function(a,b){return a+b;},0);

        var revTypeChart = new Chart(document.getElementById('revTypeChart'), {
            type: 'doughnut',
            data: {
                labels: initSlice.labels,
                datasets: [{
                    data: initSlice.vals,
                    backgroundColor: initSlice.colors,
                    borderWidth: 3,
                    borderColor: '#fff',
                    hoverOffset: 8,
                    hoverBorderWidth: 3,
                }]
            },
            options: {
                maintainAspectRatio: false,
                cutout: '72%',
                layout: { padding: 6 },
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            label: function(ctx) {
                                var t = ctx.chart.data.datasets[0].data.reduce(function(a,b){return a+b;},0);
                                var pct = t > 0 ? Math.round(ctx.raw/t*100) : 0;
                                return ' $' + ctx.raw.toLocaleString() + '  (' + pct + '%)';
                            }
                        }
                    }
                }
            },
            plugins: [centerPlugin]
        });

        // Dropdown handler
        var selectEl = document.getElementById('revTypeFySelect');
        if (selectEl) {
            selectEl.value = currentFyLbl;
            selectEl.addEventListener('change', function() {
                var slice = getSlice(this.value);
                revTypeChart.data.datasets[0].data = slice.vals;
                revTypeChart.update();
            });
        }
    }

    {
        const fy    = revData.fy_breakdown;
        const fyLbl = fy.map(r => r.label);
        const fyHighlightPlugin = {
            id: 'fyHighlight',
            beforeDraw(chart) {
                const { ctx, chartArea: { top, bottom } } = chart;
                const currentIdx = fy.findIndex(r => r.is_current);
                if (currentIdx < 0) return;
                const meta = chart.getDatasetMeta(0);
                const bar  = meta.data[currentIdx];
                if (!bar) return;
                const hw = (bar.width || 40) / 2 + 10;
                ctx.save();
                ctx.fillStyle = 'rgba(65,216,180,0.07)';
                const bx = bar.x - hw;
                const bw = hw * 2;
                if (ctx.roundRect) ctx.roundRect(bx, top - 8, bw, bottom - top + 8, [6,6,0,0]);
                else ctx.rect(bx, top - 8, bw, bottom - top + 8);
                ctx.fill();
                ctx.font = '700 8px Inter';
                ctx.fillStyle = '#0ba882';
                ctx.textAlign = 'center';
                ctx.textBaseline = 'top';
                ctx.fillText('CURRENT', bar.x, top + 3);
                ctx.restore();
            }
        };
        const fyTotalPlugin = {
            id: 'fyTotalLabels',
            afterDatasetsDraw(chart) {
                const { ctx, scales: { y } } = chart;
                fy.forEach(function(row, i) {
                    const contractTotal = (row.sub || 0) + (row.ot || 0);
                    if (!contractTotal) return;
                    const meta = chart.getDatasetMeta(0);
                    if (!meta.data[i]) return;
                    const bar = meta.data[i];
                    // position label above the full stacked bar (incl. RP)
                    const stackTop = row.total || contractTotal;
                    const yPos = y.getPixelForValue(stackTop);
                    ctx.save();
                    ctx.font = 'bold 9px Inter';
                    ctx.textAlign = 'center';
                    ctx.textBaseline = 'bottom';
                    ctx.fillStyle = '#29294C';
                    ctx.fillText('$' + Math.round(contractTotal/1000) + 'K', bar.x, yPos - 4);
                    ctx.restore();
                });
            }
        };
        new Chart(document.getElementById('revFYChart'), {
            type: 'bar',
            data: {
                labels: fyLbl,
                datasets: [
                    { label: 'Annual Client',   data: fy.map(r => r.sub),      backgroundColor: fy.map(r => r.is_current ? 'rgba(65,216,180,1.0)'  : 'rgba(65,216,180,0.60)'),  borderRadius: 4, borderSkipped: false },
                    { label: 'One Time Client', data: fy.map(r => r.ot),       backgroundColor: fy.map(r => r.is_current ? 'rgba(255,157,87,1.0)'  : 'rgba(255,157,87,0.60)'),  borderRadius: 4, borderSkipped: false },
                    { label: 'Reward Points',   data: fy.map(r => r.extra_rp), backgroundColor: fy.map(r => r.is_current ? 'rgba(167,125,255,1.0)' : 'rgba(167,125,255,0.60)'), borderRadius: 4, borderSkipped: false },
                ]
            },
            options: {
                maintainAspectRatio: false,
                layout: { padding: { top: 24 } },
                plugins: {
                    legend: { position:'bottom', labels:{ font:REV_FONT, color:REV_DARK, padding:10, boxWidth:9, boxHeight:9 } },
                    tooltip: {
                        callbacks: {
                            label: ctx => ` ${ctx.dataset.label}: $${ctx.raw.toLocaleString()}`,
                            afterBody: (items) => {
                                const idx = items[0].dataIndex;
                                const row = fy[idx];
                                const contractTotal = (row.sub || 0) + (row.ot || 0);
                                const lines = [`Contract Total: $${contractTotal.toLocaleString()}  •  ${row.client_count} clients`];
                                if (row.extra_rp > 0) lines.push(`+ Reward Points: $${row.extra_rp.toLocaleString()} (not in total)`);
                                return lines;
                            }
                        }
                    }
                },
                scales: {
                    x: { stacked:true, grid:{display:false}, ticks:{font:REV_FONT, color:REV_DARK} },
                    y: { stacked:true, ticks:{font:REV_FONT, color:REV_DARK, callback: v => '$' + Math.round(v/1000) + 'K'}, grid:{color:'rgba(0,0,0,0.06)'} }
                }
            },
            plugins: [fyHighlightPlugin, fyTotalPlugin]
        });
    }

    (function() {
        const fyStr = function(fy) {
            if (!fy) return null;
            return 'FY ' + String(fy).slice(2) + '-' + String(fy + 1).slice(2);
        };

        var topChart = null;

        var STATUS_COLORS = {
            'Active':                 'rgba(65,216,180,0.85)',
            'Active (Repeat client)': 'rgba(65,216,180,0.85)',
            'Inactive':               'rgba(255,157,87,0.80)',
            'Inactive (Repeat)':      'rgba(255,157,87,0.80)',
            'Churn':                  'rgba(173,181,189,0.75)',
        };

        var barLabelPlugin = {
            id: 'barLabelPlugin',
            afterDatasetsDraw: function(chart) {
                var ctx = chart.ctx;
                chart.data.datasets.forEach(function(dataset, i) {
                    var meta = chart.getDatasetMeta(i);
                    meta.data.forEach(function(bar, j) {
                        var val = dataset.data[j];
                        if (!val) return;
                        var txt = '$' + Math.round(val / 1000) + 'K';
                        ctx.save();
                        ctx.font = 'bold 9px Inter';
                        ctx.textBaseline = 'middle';
                        var txtW = ctx.measureText(txt).width;
                        var barW = bar.x - bar.base;
                        if (barW > txtW + 14) {
                            ctx.fillStyle = 'rgba(255,255,255,0.92)';
                            ctx.textAlign = 'right';
                            ctx.fillText(txt, bar.x - 5, bar.y);
                        } else {
                            ctx.fillStyle = '#6b7280';
                            ctx.textAlign = 'left';
                            ctx.fillText(txt, bar.x + 5, bar.y);
                        }
                        ctx.restore();
                    });
                });
            }
        };

        var drawTopChart = function(data) {
            var wrap = document.getElementById('revTopChartWrap');
            wrap.style.height = Math.max(data.length * 28 + 20, 160) + 'px';
            if (topChart) { topChart.destroy(); topChart = null; }
            var oldCanvas = document.getElementById('revTopChart');
            var newCanvas = document.createElement('canvas');
            newCanvas.id = 'revTopChart';
            oldCanvas.parentNode.replaceChild(newCanvas, oldCanvas);
            var names  = data.map(function(c, i) { return '#' + (i+1) + '  ' + c.name; });
            var vals   = data.map(function(c) { return c.value; });
            var colors = data.map(function(c) { return STATUS_COLORS[c.status] || 'rgba(65,216,180,0.75)'; });
            var avg = vals.length ? vals.reduce(function(a,b){return a+b;},0) / vals.length : 0;
            var avgLinePlugin = {
                id: 'avgLine',
                afterDraw: function(chart) {
                    if (!avg) return;
                    var ctx = chart.ctx;
                    var xScale = chart.scales['x'];
                    var xPos = xScale.getPixelForValue(avg);
                    var ca = chart.chartArea;
                    ctx.save();
                    ctx.beginPath();
                    ctx.setLineDash([4, 4]);
                    ctx.strokeStyle = 'rgba(100,100,160,0.40)';
                    ctx.lineWidth = 1.5;
                    ctx.moveTo(xPos, ca.top);
                    ctx.lineTo(xPos, ca.bottom);
                    ctx.stroke();
                    ctx.setLineDash([]);
                    ctx.font = 'bold 8px Inter';
                    ctx.fillStyle = '#9090a8';
                    ctx.textAlign = 'center';
                    ctx.textBaseline = 'bottom';
                    ctx.fillText('Avg $' + Math.round(avg/1000) + 'K', xPos, ca.top - 2);
                    ctx.restore();
                }
            };
            topChart = new Chart(newCanvas, {
                type: 'bar',
                data: {
                    labels: names,
                    datasets: [{ data: vals, backgroundColor: colors, borderRadius: 5, borderSkipped: false, barThickness: 20 }]
                },
                options: {
                    indexAxis: 'y',
                    maintainAspectRatio: false,
                    layout: { padding: { right: 50, top: 18 } },
                    onClick: function(e, els) {
                        if (els.length) {
                            var c = data[els[0].index];
                            if (c.id) window.location.href = '/client/' + c.id + '?back=%2F';
                        }
                    },
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: function(ctx) {
                                    var c = data[ctx.dataIndex];
                                    return [
                                        '  Contract Value: $' + Number(ctx.raw).toLocaleString('en-US'),
                                        '  Status: ' + (c.status || '—'),
                                        '  Agreement FY: ' + (fyStr(c.fy) || '—'),
                                    ];
                                }
                            }
                        }
                    },
                    scales: {
                        x: { grid:{color:'rgba(0,0,0,0.06)'}, ticks:{font:REV_FONT, color:REV_DARK, callback: function(v) { return '$' + Math.round(v/1000) + 'K'; }} },
                        y: { grid:{display:false}, ticks:{font:REV_FONT, color:REV_DARK, crossAlign:'far'} }
                    }
                },
                plugins: [barLabelPlugin, avgLinePlugin]
            });
            newCanvas.style.cursor = 'pointer';
            var lbl = document.getElementById('revTopChartLbl');
            if (lbl) lbl.textContent = data.length + ' client' + (data.length !== 1 ? 's' : '');
        };

        window.switchTopChart = function(mode) {
            var activeBtn   = document.getElementById('topChartActiveBtn');
            var lifetimeBtn = document.getElementById('topChartLifetimeBtn');
            if (mode === 'active') {
                activeBtn.style.background   = '#0ba882';
                activeBtn.style.color        = 'white';
                lifetimeBtn.style.background = 'transparent';
                lifetimeBtn.style.color      = '#9ca3af';
                drawTopChart(revData.top_active_clients);
            } else {
                lifetimeBtn.style.background = '#0ba882';
                lifetimeBtn.style.color      = 'white';
                activeBtn.style.background   = 'transparent';
                activeBtn.style.color        = '#9ca3af';
                drawTopChart(revData.top_clients);
            }
        };

        drawTopChart(revData.top_active_clients);
    })();
}
</script>

<!-- ── Status tooltip (fixed, JS-positioned) ─────────────── -->
<div id="statusInfoTip" style="display:none;position:fixed;z-index:99999;width:230px;background:#fff;border:1px solid #e0e0e8;border-radius:10px;box-shadow:0 8px 28px rgba(0,0,0,0.14);padding:12px 14px;font-size:0.72rem;line-height:1.6;color:#374151;pointer-events:none;">
    <strong style="display:block;font-size:0.72rem;color:#111;margin-bottom:2px;">Active</strong>
    Clients currently running challenges on the platform.
    <strong style="display:block;font-size:0.72rem;color:#111;margin-top:8px;margin-bottom:2px;">Churn</strong>
    Clients who have disengaged and are no longer participating or responding to programs.
    <strong style="display:block;font-size:0.72rem;color:#111;margin-top:8px;margin-bottom:2px;">Inactive (Repeat)</strong>
    Returning clients who have previously run one-time challenges but are not currently active.
    <strong style="display:block;font-size:0.72rem;color:#111;margin-top:8px;margin-bottom:2px;">Active (Repeat)</strong>
    Returning clients who are currently running a new challenge on the platform.
</div>

<script is:inline>
(function () {
  var tip = document.getElementById('statusInfoTip');
  window.showStatusTip = function (btn) {
    if (!tip) return;
    var rect = btn.getBoundingClientRect();
    tip.style.display = 'block';
    var TW = 230, TH = tip.offsetHeight || 220, PAD = 10;
    var left = rect.right + 8;
    var top  = rect.top;
    // flip left if it would overflow the right edge
    if (left + TW + PAD > window.innerWidth) left = rect.left - TW - 8;
    // clamp vertical so it never goes off screen
    if (top + TH + PAD > window.innerHeight) top = window.innerHeight - TH - PAD;
    if (top < PAD) top = PAD;
    tip.style.left = left + 'px';
    tip.style.top  = top  + 'px';
  };
  window.hideStatusTip = function () {
    if (tip) tip.style.display = 'none';
  };
})();
</script>

